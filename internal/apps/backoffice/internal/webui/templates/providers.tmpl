{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false"><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Administration</p><h1>{{if .Providers.Editor}}{{if .Providers.Editor.New}}Add provider{{else}}{{.Providers.Editor.Row.ID}}{{end}}{{else}}Providers{{end}}</h1><p>Review configured providers and manage database-backed provider definitions.</p></div>{{if .Providers.Editor}}<a class="btn btn-outline-secondary" href="{{path "/providers"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All providers</a>{{else}}<a class="btn btn-primary" href="{{path "/providers?new=1"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add provider</a>{{end}}</header>
{{if .Error}}<div class="alert alert-danger" role="alert"><h2 class="h5">{{.Error.Heading}}</h2><p class="mb-0">{{.Error.Message}}</p></div>{{end}}
{{if .Providers.Editor}}{{template "provider-editor" .}}{{else}}
<section class="card"><header class="card-header"><h2 class="card-title">Provider definitions</h2><span class="count-badge">{{len .Providers.Rows}}</span></header><div class="card-body"><p class="text-body-secondary mb-0">Configuration providers are read-only. Managed changes apply to new sessions and resets; active sessions keep their bound revisions.</p><p class="support-meta mt-2 mb-0">Provider state version {{.Providers.Version}}</p><p class="small text-body-secondary d-lg-none mb-0 mt-2">Scroll the table sideways to see all columns.</p></div>
<div class="table-responsive" tabindex="0" role="region" aria-label="Provider definitions table, horizontally scrollable"><table class="table table-hover access-table"><thead><tr><th scope="col">Provider</th><th scope="col">Source</th><th scope="col">Type</th><th scope="col">Model or mode</th><th scope="col">Pool members</th><th scope="col">State</th><th scope="col">Restore</th></tr></thead><tbody>{{range .Providers.Rows}}<tr><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.ID}}</a><div class="support-meta text-break">{{.Revision}}</div></td><td>{{.Source}}</td><td><code>{{.Type}}</code></td><td>{{if .ModelOrMode}}{{.ModelOrMode}}{{else}}—{{end}}</td><td class="text-break">{{if .Members}}{{.Members}}{{else}}—{{end}}</td><td><span class="status-chip {{if .Enabled}}status-chip--success{{else}}status-chip--warning{{end}}">{{.State}}</span></td><td>{{if .Reproducible}}Pinned inputs{{else}}External inputs remain{{end}}</td></tr>{{else}}<tr><td colspan="7"><span class="empty-table-message">No provider definitions.</span></td></tr>{{end}}</tbody></table></div></section>{{end}}
</div></main>{{end}}

{{define "provider-editor"}}{{with .Providers.Editor}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Current state</h2>{{if not .New}}<a href="{{path .Row.DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Refresh state</a>{{end}}</header><div class="card-body"><dl class="fact-list"><dt>Source</dt><dd>{{if .New}}managed{{else}}{{.Row.Source}}{{if .Row.ReadOnly}} · Read-only{{end}}{{end}}</dd><dt>State version</dt><dd>{{.Row.Version}}</dd>{{if not .New}}<dt>Revision</dt><dd class="text-break"><code>{{.Row.Revision}}</code></dd><dt>State</dt><dd>{{.Row.State}}</dd><dt>Restore</dt><dd>{{if .Row.Reproducible}}Balda-controlled inputs are pinned.{{else}}External inputs remain outside the revision.{{end}}</dd>{{end}}</dl></div></section>
{{if or .Row.ReadOnly .Row.Deleted}}<section class="card"><header class="card-header"><h2 class="card-title">{{if .Row.Deleted}}Deleted provider{{else}}Configuration provider{{end}}</h2></header><div class="card-body"><p>{{if .Row.Deleted}}This retained definition cannot be selected for new sessions. Existing exact bindings may still restore it.{{else}}Edit this provider in the host configuration. Browser mutations are unavailable.{{end}}</p><dl class="fact-list"><dt>Provider ID</dt><dd>{{.Row.ID}}</dd><dt>Canonical type</dt><dd><code>{{.Row.Type}}</code></dd><dt>Model or mode</dt><dd>{{if .Row.ModelOrMode}}{{.Row.ModelOrMode}}{{else}}—{{end}}</dd><dt>Pool members</dt><dd>{{if .Row.Members}}{{.Row.Members}}{{else}}—{{end}}</dd><dt>API key</dt><dd>{{if .HasAPIKey}}Present{{else}}Not present{{end}}</dd><dt>Protected environment names</dt><dd>{{if .EnvironmentNames}}{{range $index, $name := .EnvironmentNames}}{{if $index}}, {{end}}<code>{{$name}}</code>{{end}}{{else}}None{{end}}</dd></dl></div></section>
{{else}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">{{if .New}}New managed provider{{else}}Edit managed provider{{end}}</h2></header><div class="card-body"><form action="{{path .Action}}" method="post" autocomplete="off"{{if .New}} hx-boost="false"{{else}} hx-post="{{path .Action}}" hx-target="#main-content" hx-swap="outerHTML"{{end}}><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}">
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="provider-id">Provider ID</label>{{if .New}}<input class="form-control" id="provider-id" name="id" pattern="[A-Za-z0-9_-]+" maxlength="128" required>{{else}}<input class="form-control" id="provider-id" value="{{.Row.ID}}" readonly>{{end}}<p class="form-text">Immutable and shared with configured provider IDs.</p></div>
<div class="col-md-6"><label class="form-label" for="provider-type">Provider type</label>{{if .New}}<select class="form-select" id="provider-type" name="type" required>{{range .Types}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>{{else}}<input type="hidden" name="type" value="{{.Row.Type}}"><input class="form-control" id="provider-type" value="{{.Row.Type}}" readonly>{{end}}<p class="form-text">Generic commands and executable overrides are not managed here.</p></div>
<div class="col-md-6"><label class="form-label" for="provider-model">Model</label><input class="form-control" id="provider-model" name="model" value="{{.Model}}" maxlength="512"></div><div class="col-md-6"><label class="form-label" for="provider-reasoning">Reasoning effort</label><select class="form-select" id="provider-reasoning" name="reasoning_effort"><option value="">Provider default</option><option value="none"{{if eq .ReasoningEffort "none"}} selected{{end}}>none</option><option value="minimal"{{if eq .ReasoningEffort "minimal"}} selected{{end}}>minimal</option><option value="low"{{if eq .ReasoningEffort "low"}} selected{{end}}>low</option><option value="medium"{{if eq .ReasoningEffort "medium"}} selected{{end}}>medium</option><option value="high"{{if eq .ReasoningEffort "high"}} selected{{end}}>high</option><option value="xhigh"{{if eq .ReasoningEffort "xhigh"}} selected{{end}}>xhigh</option></select></div>
<div class="col-md-6"><label class="form-label" for="provider-mode">Mode</label><input class="form-control" id="provider-mode" name="mode" value="{{.Mode}}" maxlength="256"></div><div class="col-md-6"><label class="form-label" for="provider-timeout">Hosted timeout</label><input class="form-control" id="provider-timeout" name="timeout" value="{{.Timeout}}" maxlength="64" placeholder="2m"></div>
<div class="col-md-6"><label class="form-label" for="provider-bridge">Bridge version</label><input class="form-control" id="provider-bridge" name="bridge_version" value="{{.BridgeVersion}}" maxlength="128"></div><div class="col-md-6"><label class="form-label" for="provider-registry">Registry ID</label><input class="form-control" id="provider-registry" name="registry_id" value="{{.RegistryID}}" maxlength="256"{{if not .New}} readonly{{end}}></div>
<div class="col-md-6"><label class="form-label" for="provider-model-config">Model config ID</label><input class="form-control" id="provider-model-config" name="model_config_id" value="{{.ModelConfigID}}" maxlength="256"></div><div class="col-md-6"><label class="form-label" for="provider-reasoning-config">Reasoning config ID</label><input class="form-control" id="provider-reasoning-config" name="reasoning_effort_config_id" value="{{.ReasoningEffortConfigID}}" maxlength="256"></div>
<div class="col-md-6"><label class="form-label" for="provider-inherit-env">Inherited environment</label><select class="form-select" id="provider-inherit-env" name="inherit_env"><option value="default"{{if eq .InheritEnv "default"}} selected{{end}}>Driver default</option><option value="yes"{{if eq .InheritEnv "yes"}} selected{{end}}>Enabled</option><option value="no"{{if eq .InheritEnv "no"}} selected{{end}}>Disabled</option></select></div>
<div class="col-12"><label class="form-label" for="provider-extra-args">Extra arguments</label><textarea class="form-control" id="provider-extra-args" name="extra_args" rows="3" maxlength="8192">{{.ExtraArgs}}</textarea><p class="form-text">One argument per line. Executable commands cannot be changed.</p></div>
<div class="col-md-6"><label class="form-label" for="provider-mcp">MCP server IDs</label><textarea class="form-control" id="provider-mcp" name="mcp_servers" rows="4" maxlength="8192">{{.MCPServers}}</textarea><p class="form-text">One ID per line.</p></div><div class="col-md-6"><label class="form-label" for="provider-members">Pool members</label><textarea class="form-control" id="provider-members" name="pool_members" rows="4" maxlength="8192">{{.PoolMembers}}</textarea><p class="form-text">Ordered, one provider ID per line.</p></div>
<div class="col-12"><label class="form-label" for="provider-instructions">System instructions</label><textarea class="form-control" id="provider-instructions" name="system_instructions" rows="4" maxlength="32768">{{.SystemInstructions}}</textarea></div>
<fieldset class="col-md-6"><legend class="h6">API key</legend><p class="support-meta">Current value: {{if .HasAPIKey}}present{{else}}not present{{end}}. It is never shown.</p><select class="form-select mb-2" name="api_key_action" aria-label="API key action"><option value="keep">Keep current value</option><option value="replace">Replace with value below</option><option value="clear">Clear value</option></select><label class="form-label" for="provider-api-key">Replacement API key</label><input class="form-control" type="password" id="provider-api-key" name="api_key" value="" maxlength="16384" autocomplete="new-password"></fieldset>
<fieldset class="col-md-6"><legend class="h6">ACP environment</legend><p class="support-meta">Current names: {{if .EnvironmentNames}}{{range $index, $name := .EnvironmentNames}}{{if $index}}, {{end}}<code>{{$name}}</code>{{end}}{{else}}none{{end}}. Values are never shown.</p><select class="form-select mb-2" name="environment_action" aria-label="Environment action"><option value="keep">Keep current values</option><option value="replace">Replace all with entries below</option><option value="clear">Clear all values</option></select><label class="form-label" for="provider-environment">Replacement environment</label><textarea class="form-control" id="provider-environment" name="environment" rows="4" maxlength="65536" autocomplete="off" placeholder="NAME=value"></textarea><p class="form-text">One <code>NAME=value</code> entry per line. Empty values are preserved.</p></fieldset></div>
<div class="action-row mt-4"><button class="btn btn-primary" type="submit">{{if .New}}Create provider{{else}}Save provider{{end}}</button></div></form></div></section>
{{if not .New}}<section class="card"><header class="card-header"><h2 class="card-title">Availability</h2></header><div class="card-body"><form action="{{path .Action}}/selection" method="post" hx-post="{{path .Action}}/selection" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><input type="hidden" name="enabled" value="{{if .Row.Enabled}}no{{else}}yes{{end}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="provider-confirm-selection" required><label class="form-check-label" for="provider-confirm-selection">Confirm {{if .Row.Enabled}}disabling{{else}}enabling{{end}} this provider for new bindings.</label></div><button class="btn btn-outline-primary" type="submit">{{if .Row.Enabled}}Disable provider{{else}}Enable provider{{end}}</button></form>
<form class="mt-4" action="{{path .Action}}/delete" method="post" hx-post="{{path .Action}}/delete" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="provider-confirm-delete" required><label class="form-check-label" for="provider-confirm-delete">Confirm deleting this provider. Retained revisions remain available only to existing exact bindings.</label></div><button class="btn btn-outline-danger" type="submit">Delete provider</button></form></div></section>{{end}}
{{end}}{{end}}{{end}}
