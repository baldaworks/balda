{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid py-3"><h1>Overview</h1>
    <div class="row g-3">
      {{range .Capabilities}}<div class="col-12 col-md-6 col-xl-4"><article class="card h-100"><div class="card-body"><h2 class="h5">{{.Name}}</h2><p class="mb-1"><strong>Mode:</strong> {{.Mode}}</p>{{if .ListenAddr}}<p class="mb-1"><strong>Listen:</strong> <code>{{.ListenAddr}}</code></p>{{end}}{{if .Endpoint}}<p class="mb-1"><strong>Endpoint:</strong> <code>{{.Endpoint}}</code></p>{{end}}{{if .RouteCount}}<p class="mb-1"><strong>Routes:</strong> {{.RouteCount}}</p>{{end}}{{if .Streaming}}<span class="badge text-bg-info">Streaming</span>{{end}}</div></article></div>{{else}}<div class="col-12"><p class="text-body-secondary">No configured capabilities.</p></div>{{end}}
    </div>
  </div>
</main>{{end}}
