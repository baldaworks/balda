{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid py-3"><h1>Overview</h1><p class="text-body-secondary">These integrations are enabled in Balda configuration. This page does not check whether they are currently healthy or connected.</p>
    <div class="row g-3">
      {{range .Capabilities}}<div class="col-12 col-md-6 col-xl-4"><article class="card h-100"><div class="card-body"><h2 class="h5">{{.Name}}</h2><p><span class="badge text-bg-secondary">Configured</span>{{if .Streaming}} <span class="badge text-bg-light">Streaming configured</span>{{end}}</p><details><summary>Configuration details</summary><p class="mb-1 mt-2"><strong>Mode:</strong> {{.Mode}}</p>{{if .ListenAddr}}<p class="mb-1"><strong>Listen:</strong> <code>{{.ListenAddr}}</code></p>{{end}}{{if .Endpoint}}<p class="mb-1"><strong>Endpoint:</strong> <code>{{.Endpoint}}</code></p>{{end}}{{if .RouteCount}}<p class="mb-1"><strong>Routes:</strong> {{.RouteCount}}</p>{{end}}</details></div></article></div>{{else}}<div class="col-12"><div class="card"><div class="card-body"><h2 class="h5">No integrations configured</h2><p class="mb-0">Enable an integration in the Balda configuration and restart the service. Then return here to review the enabled configuration.</p></div></div></div>{{end}}
    </div>
  </div>
</main>{{end}}
