{{define "content"}}<main id="main-content" class="app-content" tabindex="-1"><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Workspace</p><h1>Overview</h1><p>Integrations enabled in Balda configuration. Live health and connection status are not checked here.</p></div></header>
<div class="card-grid">{{range .Capabilities}}<article class="card"><header class="card-header"><h2 class="card-title">{{.Name}}</h2><span class="status-chip status-chip--info">Configured</span></header><div class="card-body"><dl class="fact-list"><dt>Mode</dt><dd>{{.Mode}}</dd>{{if .RouteCount}}<dt>Routes</dt><dd>{{.RouteCount}}</dd>{{end}}{{range .Settings}}<dt>{{.Label}}</dt><dd>{{.Value}}</dd>{{end}}</dl>{{if .Endpoints}}<details class="mt-3"><summary>Callback locations</summary><dl class="fact-list mt-3">{{range .Endpoints}}<dt>{{.Label}}</dt><dd><code>{{.URL}}</code></dd>{{end}}</dl></details>{{end}}</div></article>{{else}}<div class="page-state"><i class="bi bi-plug" aria-hidden="true"></i><div><h2 class="h5">No integrations configured</h2><p class="mb-0">Enable an integration in the Balda configuration and restart the service. Return here to review its configuration.</p></div></div>{{end}}</div>
</div></main>{{end}}
