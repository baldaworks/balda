{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false">
<div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{if .Schedules.Editor}}{{if .Schedules.Editor.New}}Add schedule{{else}}{{.Schedules.Editor.ID}}{{end}}{{else}}Schedules{{end}}</h1><p>View recurring work and manage schedules created in Backoffice.</p></div>{{if .Schedules.Editor}}<a class="btn btn-outline-secondary" href="{{path "/schedules"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All schedules</a>{{else}}<a class="btn btn-primary" href="{{path "/schedules?new=1"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add schedule</a>{{end}}</header>
{{if .Error}}<div class="alert alert-danger" role="alert"><h2 class="h5">{{.Error.Heading}}</h2><p class="mb-0">{{.Error.Message}}</p></div>{{end}}
{{if .Schedules.Editor}}{{template "schedule-editor" .}}{{else}}
<section class="card"><header class="card-header"><h2 class="card-title">Recurring schedules</h2><span class="count-badge">{{len .Schedules.Rows}}</span></header>
<div class="card-body"><p class="text-body-secondary mb-0">Configuration schedules are read-only. Backoffice schedules remain available after a restart. All times are UTC.</p><p class="small text-body-secondary d-lg-none mb-0 mt-2">Scroll the table sideways to see all columns.</p></div>
<div class="table-responsive" tabindex="0" role="region" aria-label="Schedules table, horizontally scrollable"><table class="table table-hover access-table schedule-inventory-table"><thead><tr><th scope="col">Schedule</th><th scope="col">Source</th><th scope="col">Destination</th><th scope="col">State</th><th scope="col">Next run</th><th scope="col">Last run</th></tr></thead><tbody>
{{range .Schedules.Rows}}<tr><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.ID}}</a><div class="small text-body-secondary text-break">{{.Cron}}</div></td><td class="text-nowrap">{{.Source}}</td><td class="text-break">{{.Locator}}</td><td><span class="status-chip {{if .Enabled}}status-chip--success{{else}}status-chip--warning{{end}}">{{if .Enabled}}{{.Status}}{{else}}Disabled{{end}}</span></td><td>{{.NextRun}}</td><td>{{.LastRun}}</td></tr>{{else}}<tr><td colspan="6"><span class="empty-table-message">No recurring schedules yet.</span></td></tr>{{end}}
</tbody></table></div></section>{{end}}
</div></main>{{end}}

{{define "schedule-editor"}}{{with .Schedules.Editor}}
{{if not .New}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">Current state</h2><a href="{{path .Row.DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Refresh state</a></header><div class="card-body"><dl class="fact-list"><dt>Source</dt><dd>{{.Row.Source}}{{if .Row.ReadOnly}} · Read-only{{end}}</dd><dt>State</dt><dd>{{if .Row.Enabled}}{{.Row.Status}}{{else}}Disabled{{end}}</dd><dt>Next run</dt><dd>{{.Row.NextRun}}</dd><dt>Last run</dt><dd>{{.Row.LastRun}}</dd><dt>Report locator</dt><dd>{{.Row.Locator}}</dd></dl></div></section>{{end}}
{{if or .Row.ReadOnly .Row.Deleted}}<section class="card"><header class="card-header"><h2 class="card-title">{{if .Row.Deleted}}Archived schedule{{else}}Configuration schedule{{end}}</h2></header><div class="card-body"><p>{{if .Row.Deleted}}This schedule was removed. Its run history remains available.{{else}}Edit this schedule in the host configuration. Browser editing, enable/disable and deletion are unavailable.{{end}}</p><dl class="fact-list"><dt>Cron</dt><dd><code>{{.Cron}}</code></dd><dt>Report locator</dt><dd class="text-break">{{.Row.Locator}}</dd><dt>Content</dt><dd class="text-break" style="white-space: pre-wrap">{{.Content}}</dd></dl></div></section>
{{else}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">{{if .New}}New schedule{{else}}Edit schedule{{end}}</h2></header><div class="card-body"><form action="{{path .Action}}" method="post" autocomplete="off"{{if .New}} hx-boost="false"{{else}} hx-post="{{path .Action}}" hx-target="#main-content" hx-swap="outerHTML"{{end}}><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{if not .New}}<input type="hidden" name="expected_version" value="{{.Row.Version}}">{{end}}
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="schedule-id">Schedule ID</label>{{if .New}}<input class="form-control" id="schedule-id" name="id" pattern="[a-z0-9][a-z0-9_-]*" maxlength="64" required>{{else}}<input class="form-control" id="schedule-id" value="{{.ID}}" readonly>{{end}}<p class="form-text">Unique across configuration and Backoffice; fixed after creation.</p></div><div class="col-md-6"><label class="form-label" for="schedule-cron">Cron (UTC)</label><input class="form-control" id="schedule-cron" name="cron" value="{{.Cron}}" maxlength="128" placeholder="0 9 * * *" required><p class="form-text">Five fields: minute, hour, day of month, month, day of week.</p></div>
<div class="col-12"><label class="form-label" for="schedule-locator">Report locator (optional)</label><input class="form-control" id="schedule-locator" name="locator" value="{{.Locator}}" maxlength="512" placeholder="telegram:123456:0"><p class="form-text">Leave empty to keep the output in run history only. To send a report, enter a public <code>&lt;channel_type&gt;:&lt;address_key&gt;</code> locator; the address does not need to exist yet.</p></div>
<div class="col-12"><label class="form-label" for="schedule-content">Content</label><textarea class="form-control" id="schedule-content" name="content" rows="5" maxlength="16384" required>{{.Content}}</textarea></div>
</div>
<div class="action-row mt-4"><button class="btn btn-primary" type="submit">{{if .New}}Create schedule{{else}}Save schedule{{end}}</button></div></form></div></section>
{{if not .New}}<section class="card"><header class="card-header"><h2 class="card-title">Availability</h2></header><div class="card-body"><form action="{{path .Action}}/selection" method="post" hx-post="{{path .Action}}/selection" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><input type="hidden" name="enabled" value="{{if .Row.Enabled}}no{{else}}yes{{end}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="schedule-confirm-selection" required><label class="form-check-label" for="schedule-confirm-selection">Confirm {{if .Row.Enabled}}disabling{{else}}enabling{{end}} this schedule.</label></div><button class="btn btn-outline-primary" type="submit">{{if .Row.Enabled}}Disable schedule{{else}}Enable schedule{{end}}</button></form><form class="mt-4" action="{{path .Action}}/delete" method="post" hx-post="{{path .Action}}/delete" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="schedule-confirm-delete" required><label class="form-check-label" for="schedule-confirm-delete">Confirm deleting this schedule. Run history remains available.</label></div><button class="btn btn-outline-danger" type="submit">Delete schedule</button></form></div></section>{{end}}
{{end}}
{{if not .New}}
{{if .RunDetail}}<section class="card mt-4" aria-label="Run input and output"><header class="card-header"><h2 class="card-title">Run detail · {{.RunDetail.State}}</h2></header><div class="card-body"><h3 class="h6">Input</h3><pre class="text-wrap">{{.RunDetail.Input}}</pre><h3 class="h6">Output</h3>{{if .RunDetail.Output}}<pre class="text-wrap">{{.RunDetail.Output}}</pre>{{else}}<p class="text-body-secondary">No output recorded yet.</p>{{end}}</div></section>{{end}}
{{if not .Row.Deleted}}<section class="card mt-4"><header class="card-header"><h2 class="card-title">Run now</h2></header><div class="card-body"><p>A manual run queues one execution and does not change the next scheduled time.</p><form action="{{path .Action}}/runs" method="post" hx-post="{{path .Action}}/runs" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="request_key" value="{{.RunRequestKey}}">{{if not .Row.Enabled}}<div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm_disabled" value="yes" id="schedule-confirm-disabled-run" required><label class="form-check-label" for="schedule-confirm-disabled-run">Confirm running this disabled schedule once.</label></div>{{end}}<button class="btn btn-outline-primary" type="submit">Run now</button></form></div></section>{{end}}
{{if .HistoryLoaded}}<section class="card mt-4"><header class="card-header"><h2 class="card-title">Run history</h2></header><div class="card-body"><p class="text-body-secondary mb-0">Newest first. Refresh this page to see current execution state. Times are UTC.</p><p class="small text-body-secondary d-lg-none mb-0 mt-2">Scroll the table sideways to see all columns.</p></div><div class="table-responsive" tabindex="0" role="region" aria-label="Schedule run history, horizontally scrollable"><table class="table table-hover access-table schedule-history-table"><thead><tr><th scope="col">Requested</th><th scope="col">Trigger</th><th scope="col">Due</th><th scope="col">State</th><th scope="col">Completed</th></tr></thead><tbody>{{range .Runs}}<tr><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.Requested}}</a></td><td class="text-nowrap">{{.Trigger}}</td><td>{{.Due}}</td><td>{{.State}}{{if .Failure}}<div class="small text-body-secondary">{{.Failure}}</div>{{end}}</td><td>{{.Completed}}</td></tr>{{else}}<tr><td colspan="5"><span class="empty-table-message">No runs yet.</span></td></tr>{{end}}</tbody></table></div>{{if .NextHistoryPath}}<div class="card-body"><a class="btn btn-outline-secondary" href="{{path .NextHistoryPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Older runs</a></div>{{end}}</section>{{end}}
{{end}}
{{end}}{{end}}
