{{define "content"}}<main id="main-content" class="app-content" tabindex="-1"><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Workspace</p><h1>Agent</h1><p>Effective read-only agent configuration loaded at startup.</p></div></header>
{{with .Agent}}<div class="card-grid"><article class="card"><header class="card-header"><h2 class="card-title">Provider</h2><span class="status-chip status-chip--info">Configured</span></header><div class="card-body"><dl class="fact-list"><dt>Profile</dt><dd>{{if .Profile}}<code>{{.Profile}}</code>{{else}}Not configured{{end}}</dd><dt>Provider ID</dt><dd>{{if .ProviderID}}<code>{{.ProviderID}}</code>{{else}}Not configured{{end}}</dd><dt>Provider type</dt><dd>{{if .ProviderType}}<code>{{.ProviderType}}</code>{{else}}Not configured{{end}}</dd><dt>Model</dt><dd>{{if .Model}}<code>{{.Model}}</code>{{else}}Not configured{{end}}</dd><dt>Reasoning effort</dt><dd>{{if .ReasoningEffort}}<code>{{.ReasoningEffort}}</code>{{else}}Not configured{{end}}</dd></dl></div></article><article class="card"><header class="card-header"><h2 class="card-title">Global instruction</h2><span class="status-chip status-chip--info">Read-only</span></header><div class="card-body">{{if .GlobalInstruction}}<pre class="mb-0 text-wrap">{{.GlobalInstruction}}</pre>{{else}}<p class="mb-0 text-secondary">No global instruction configured.</p>{{end}}</div></article></div>{{end}}
<p class="mt-3 text-secondary">Change the host configuration and restart Balda to apply updates.</p>
</div></main>{{end}}
