{{define "content"}}<main id="main-content" class="login-page">
  <section class="login-box" aria-labelledby="password-heading"><div class="card card-outline card-warning"><div class="card-body">
    <h1 id="password-heading" class="h3">Replace password</h1><p>Set a new password before using Backoffice.</p>
    {{with .Error}}<div class="alert alert-danger" role="alert"><strong>{{.Heading}}</strong> {{.Message}}</div>{{end}}
    <form method="post" action="/account/password" hx-boost="false">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <div class="mb-3"><label for="current-password" class="form-label">Current password</label><input id="current-password" name="current_password" type="password" class="form-control" autocomplete="current-password"></div>
      <div class="mb-3"><label for="new-password" class="form-label">New password</label><input id="new-password" name="new_password" type="password" class="form-control" autocomplete="new-password" minlength="12" maxlength="72" required autofocus></div>
      <button class="btn btn-primary" type="submit">Replace password</button>
    </form>
    <form method="post" action="/logout" hx-boost="false" class="mt-3"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="btn btn-link" type="submit">Sign out</button></form>
  </div></div></section>
</main>{{end}}
