{{define "content"}}<main id="main-content" class="login-page" data-bs-theme="dark" tabindex="-1"><section class="login-box" aria-labelledby="error-heading"><div class="card"><div class="card-body"><p class="eyebrow mb-2">Backoffice request</p>{{with .Error}}<h1 id="error-heading" class="h3">{{.Heading}}</h1><p role="alert">{{.Message}}</p>{{else}}<h1 id="error-heading" class="h3">Request failed</h1><p>The request could not be completed.</p>{{end}}<div class="action-row">{{if .StepUpURL}}<a class="btn btn-primary" href="{{.StepUpURL}}" hx-boost="false">Confirm passkey</a>{{end}}<a class="btn btn-primary" href="{{path "/"}}overview">Return to Overview</a><a class="btn btn-outline-secondary" href="{{path "/"}}login">Sign in</a></div></div></div></section></main>{{end}}
