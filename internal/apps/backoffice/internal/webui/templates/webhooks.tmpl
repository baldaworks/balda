{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false"{{if .Webhooks.Editor}}{{if .Webhooks.Editor.Secret}} data-webhook-once="{{path .Webhooks.Editor.Row.DetailPath}}"{{end}}{{end}}>
<div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{if .Webhooks.Editor}}{{if .Webhooks.Editor.New}}Add webhook{{else}}{{.Webhooks.Editor.Name}}{{end}}{{else}}Webhooks{{end}}</h1><p>View webhook routes and manage routes created in Backoffice.</p></div>{{if .Webhooks.Editor}}<a class="btn btn-outline-secondary" href="{{path "/webhooks"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All webhooks</a>{{else}}<a class="btn btn-primary" href="{{path "/webhooks?new=1"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add webhook</a>{{end}}</header>
{{if .Error}}<div class="alert alert-danger" role="alert"><h2 class="h5">{{.Error.Heading}}</h2><p class="mb-0">{{.Error.Message}}</p></div>{{end}}
{{if .Webhooks.Editor}}{{template "webhook-editor" .}}{{else}}
<section class="card"><header class="card-header"><h2 class="card-title">Webhook routes</h2><span class="count-badge">{{len .Webhooks.Rows}}</span></header><div class="card-body"><p class="text-body-secondary mb-0">Configuration routes are read-only. Backoffice routes remain available after a restart.</p><p class="small text-body-secondary d-lg-none mb-0 mt-2">Scroll the table sideways to see all columns.</p></div>
<div class="table-responsive" tabindex="0" role="region" aria-label="Webhook routes table, horizontally scrollable"><table class="table table-hover access-table"><thead><tr><th scope="col">Route name</th><th scope="col">Source</th><th scope="col">Path</th><th scope="col">Report to</th><th scope="col">State</th></tr></thead><tbody>{{range .Webhooks.Rows}}<tr><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.Name}}</a></td><td>{{.Source}}</td><td class="text-break"><code>{{.Path}}</code></td><td class="text-break">{{.ReportTo}}</td><td><span class="status-chip {{if .Enabled}}status-chip--success{{else}}status-chip--warning{{end}}">{{.State}}</span></td></tr>{{else}}<tr><td colspan="5"><span class="empty-table-message">No webhook routes yet.</span></td></tr>{{end}}</tbody></table></div></section>{{end}}
</div></main>{{end}}

{{define "webhook-editor"}}{{with .Webhooks.Editor}}
{{if .Secret}}<section class="card mb-4" aria-label="One-time webhook secret" data-binding-reveal><header class="card-header"><h2 class="card-title">Webhook secret · shown once</h2></header><div class="card-body"><p>Copy this secret now. It cannot be read again. Send it in the <code>X-Balda-Webhook-Secret</code> header.</p><div class="binding-copy-row"><input class="form-control" id="webhook-new-secret" value="{{.Secret}}" readonly autocomplete="off" spellcheck="false" data-webhook-secret><button class="btn btn-outline-secondary" type="button" data-binding-copy="webhook-new-secret">Copy secret</button></div><p class="form-text" data-binding-copy-status role="status"></p></div></section>{{end}}
{{if not .New}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">Current state</h2><a href="{{path .Row.DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Refresh state</a></header><div class="card-body"><dl class="fact-list"><dt>Source</dt><dd>{{.Row.Source}}{{if .Row.ReadOnly}} · Read-only{{end}}</dd><dt>Path</dt><dd class="text-break"><code>{{.Path}}</code></dd><dt>Report to</dt><dd class="text-break">{{.Row.ReportTo}}</dd><dt>State</dt><dd>{{.Row.State}}</dd><dt>Authentication</dt><dd>{{.AuthLabel}}</dd></dl></div></section>{{end}}
{{if or .Row.ReadOnly .Row.Deleted}}<section class="card"><header class="card-header"><h2 class="card-title">{{if .Row.Deleted}}Archived webhook{{else}}Configuration webhook{{end}}</h2></header><div class="card-body"><p>{{if .Row.Deleted}}This route was removed. New requests cannot enter it.{{else}}Edit this route in the host configuration. Browser editing, enable/disable, secret rotation and deletion are unavailable.{{end}}</p><dl class="fact-list"><dt>Route name</dt><dd>{{.Name}}</dd><dt>Path</dt><dd><code>{{.Path}}</code></dd><dt>Report to</dt><dd class="text-break">{{.Row.ReportTo}}</dd><dt>Prompt template</dt><dd><pre class="text-wrap">{{.PromptTemplate}}</pre></dd><dt>Wait for delivery</dt><dd>{{if .AckOnDelivery}}Yes{{else}}No{{end}}</dd><dt>Deduplicate by</dt><dd>{{.DedupeSource}}{{if .DedupeHeader}} · {{.DedupeHeader}}{{end}}</dd></dl></div></section>
{{else}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">{{if .New}}New webhook route{{else}}Edit webhook route{{end}}</h2></header><div class="card-body"><form action="{{path .Action}}" method="post" autocomplete="off"{{if .New}} hx-boost="false"{{else}} hx-post="{{path .Action}}" hx-target="#main-content" hx-swap="outerHTML"{{end}}><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{if not .New}}<input type="hidden" name="expected_version" value="{{.Row.Version}}">{{end}}
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="webhook-name">Route name</label>{{if .New}}<input class="form-control" id="webhook-name" name="name" pattern="[a-z0-9][a-z0-9_-]*" maxlength="64" placeholder="order_events" required>{{else}}<input class="form-control" id="webhook-name" value="{{.Name}}" readonly>{{end}}<p class="form-text">Unique across configuration and Backoffice; fixed after creation.</p></div><div class="col-md-6"><label class="form-label" for="webhook-path">Path</label><input class="form-control" id="webhook-path" name="path" value="{{.Path}}" maxlength="512" placeholder="/hooks/order-events" required><p class="form-text">Unique path for incoming POST requests.</p></div>
<div class="col-12"><label class="form-label" for="webhook-report-to">Report to (optional)</label><input class="form-control" id="webhook-report-to" name="report_to" value="{{.ReportTo}}" maxlength="512" placeholder="telegram:123456:0 or main_chat"><p class="form-text">Enter a public <code>&lt;channel_type&gt;:&lt;address_key&gt;</code> locator or managed alias. Leave empty to keep output in request history only. The address or alias mapping can be added later.</p></div>
<div class="col-12"><label class="form-label" for="webhook-prompt">Prompt template</label><textarea class="form-control" id="webhook-prompt" name="prompt_template" rows="5" maxlength="16384" required>{{.PromptTemplate}}</textarea><p class="form-text">The template turns each admitted request into an instruction for a new private session.</p></div>
<div class="col-md-6"><label class="form-label" for="webhook-dedupe-source">Deduplicate by</label><select class="form-select" id="webhook-dedupe-source" name="dedupe_source" data-webhook-dedupe><option value="request_id"{{if eq .DedupeSource "request_id"}} selected{{end}}>Request ID</option><option value="body_sha256"{{if eq .DedupeSource "body_sha256"}} selected{{end}}>Request body</option><option value="header"{{if eq .DedupeSource "header"}} selected{{end}}>Header</option></select></div><div class="col-md-6" data-webhook-dedupe-header><label class="form-label" for="webhook-dedupe-header">Deduplication header</label><input class="form-control" id="webhook-dedupe-header" name="dedupe_header" value="{{.DedupeHeader}}" maxlength="128" placeholder="X-Event-ID"><p class="form-text">Used only when deduplicating by header.</p></div>
<div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="webhook-ack" name="ack_on_delivery" value="yes"{{if .AckOnDelivery}} checked{{end}}><label class="form-check-label" for="webhook-ack">Wait for report delivery before acknowledging the POST</label></div><p class="form-text">Requires a Report to recipient.</p></div></div>
<div class="action-row mt-4"><button class="btn btn-primary" type="submit">{{if .New}}Create webhook{{else}}Save webhook{{end}}</button></div></form></div></section>
{{if not .New}}<section class="card"><header class="card-header"><h2 class="card-title">Availability and secret</h2></header><div class="card-body"><form action="{{path .Action}}/selection" method="post" hx-post="{{path .Action}}/selection" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><input type="hidden" name="enabled" value="{{if .Row.Enabled}}no{{else}}yes{{end}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="webhook-confirm-selection" required><label class="form-check-label" for="webhook-confirm-selection">Confirm {{if .Row.Enabled}}disabling{{else}}enabling{{end}} this webhook route.</label></div><button class="btn btn-outline-primary" type="submit">{{if .Row.Enabled}}Disable webhook{{else}}Enable webhook{{end}}</button></form>
<form class="mt-4" action="{{path .Action}}/rotate" method="post" hx-boost="false"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="webhook-confirm-rotate" required><label class="form-check-label" for="webhook-confirm-rotate">Confirm replacing the current secret. Existing senders must use the new secret.</label></div><button class="btn btn-outline-warning" type="submit">Rotate secret</button></form>
<form class="mt-4" action="{{path .Action}}/delete" method="post" hx-post="{{path .Action}}/delete" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="webhook-confirm-delete" required><label class="form-check-label" for="webhook-confirm-delete">Confirm deleting this route. Request history remains available.</label></div><button class="btn btn-outline-danger" type="submit">Delete webhook</button></form></div></section>{{end}}
{{end}}
{{if not .New}}
{{if not .Row.Deleted}}<section class="card mt-4"><header class="card-header"><h2 class="card-title">Test POST</h2></header><div class="card-body"><p>Submit a test request using the current prompt template. This does not require the webhook secret.</p><form action="{{path .Row.DetailPath}}/test" method="post" hx-boost="false" autocomplete="off"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><input type="hidden" name="request_key" value="{{.TestRequestKey}}"><div class="mb-3"><label class="form-label" for="webhook-test-body">Request body</label><textarea class="form-control" id="webhook-test-body" name="body" rows="5" maxlength="1048576">{{.TestBody}}</textarea></div>{{if not .Row.Enabled}}<div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirm_disabled" value="yes" id="webhook-test-disabled" required><label class="form-check-label" for="webhook-test-disabled">Confirm testing this disabled webhook route.</label></div>{{end}}<button class="btn btn-outline-primary" type="submit">Send test POST</button></form></div></section>{{end}}
{{if .HistoryLoaded}}<section class="card mt-4"><header class="card-header"><h2 class="card-title">Request history</h2></header><div class="table-responsive" tabindex="0" role="region" aria-label="Webhook request history, horizontally scrollable"><table class="table table-hover access-table"><thead><tr><th scope="col">Received</th><th scope="col">Source</th><th scope="col">Execution</th><th scope="col">Delivery</th></tr></thead><tbody>{{range .History}}<tr><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.Requested}}</a></td><td>{{.Source}}</td><td>{{.State}}</td><td>{{.DeliveryState}}</td></tr>{{else}}<tr><td colspan="4"><span class="empty-table-message">No accepted requests yet.</span></td></tr>{{end}}</tbody></table></div>{{if .NextHistoryPath}}<div class="card-body"><a href="{{path .NextHistoryPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Older requests</a></div>{{end}}</section>{{end}}
{{with .HistoryDetail}}<section class="card mt-4"><header class="card-header"><h2 class="card-title">Request detail</h2></header><div class="card-body"><dl class="fact-list"><dt>Report to</dt><dd>{{if .HasReportTo}}{{.ReportTo}}{{else}}No report{{end}}</dd><dt>Delivery</dt><dd>{{if .HasReportTo}}{{if .DeliveryState}}{{.DeliveryState}}{{else}}Pending{{end}}{{else}}No report{{end}}</dd></dl><h3 class="h6">Input</h3>{{if .InputAvailable}}<pre class="text-wrap text-break">{{.Input}}</pre>{{else}}<p>Input unavailable for this older request.</p>{{end}}<h3 class="h6">Output</h3>{{if .Output}}<pre class="text-wrap text-break">{{.Output}}</pre>{{else}}<p>No output yet.</p>{{end}}{{if .DeliveryPayload}}<h3 class="h6">Delivery payload</h3><pre class="text-wrap text-break">{{.DeliveryPayload}}</pre>{{end}}</div></section>{{end}}
{{end}}
{{end}}{{end}}
