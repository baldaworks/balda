{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid py-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1 class="mb-0">Account</h1><form method="post" action="{{path "/"}}logout" hx-boost="false"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="btn btn-outline-secondary" type="submit">Sign out</button></form></div>
    {{with .Error}}<div class="alert alert-danger" role="alert"><strong>{{.Heading}}</strong> {{.Message}}</div>{{end}}
    <section aria-labelledby="password-heading" class="card mb-3"><div class="card-body"><h2 id="password-heading" class="h4">Change password</h2><form method="post" action="{{path "/"}}account/password" hx-post="{{path "/"}}account/password" hx-target="#main-content"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><div class="row g-3"><div class="col-md-6"><label for="account-current-password" class="form-label">Current password</label><input id="account-current-password" name="current_password" type="password" class="form-control" autocomplete="current-password" required></div><div class="col-md-6"><label for="account-new-password" class="form-label">New password</label><input id="account-new-password" name="new_password" type="password" class="form-control" autocomplete="new-password" minlength="12" maxlength="72" required></div></div><p class="form-text">Changing the password signs out your other browser sessions.</p><button class="btn btn-primary" type="submit">Change password</button></form></div></section>
    {{with .User}}<section aria-labelledby="profile-heading" class="card mb-3"><div class="card-body"><h2 id="profile-heading" class="h4">Profile</h2><dl class="row"><dt class="col-sm-3">Display name</dt><dd class="col-sm-9">{{.DisplayName}}</dd><dt class="col-sm-3">Username</dt><dd class="col-sm-9">{{.Username}}</dd><dt class="col-sm-3">Role</dt><dd class="col-sm-9">{{.Role}}</dd><dt class="col-sm-3">Chat bindings</dt><dd class="col-sm-9">{{range .Bindings}}<div><code>{{.ChannelType}}:{{.Principal}}</code>{{with .DisplayName}} — {{.}}{{end}}{{if eq .ChannelType "telegram"}}<div>Telegram username: {{if .ProviderUsername}}@{{.ProviderUsername}}{{else}}—{{end}}; first name: {{if .ProviderFirstName}}{{.ProviderFirstName}}{{else}}—{{end}}</div>{{end}}</div>{{else}}Unbound{{end}}</dd></dl></div></section>{{end}}
    {{template "session_list" .}}
  </div>
</main>{{end}}
