{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid py-3"><h1>Account</h1>
    {{with .Error}}<div class="alert alert-danger" role="alert"><strong>{{.Heading}}</strong> {{.Message}}</div>{{end}}
    {{with .User}}<section aria-labelledby="profile-heading" class="card mb-3"><div class="card-body"><h2 id="profile-heading" class="h4">Profile</h2><dl class="row"><dt class="col-sm-3">Display name</dt><dd class="col-sm-9">{{.DisplayName}}</dd><dt class="col-sm-3">Username</dt><dd class="col-sm-9">{{.Username}}</dd><dt class="col-sm-3">Role</dt><dd class="col-sm-9">{{.Role}}</dd><dt class="col-sm-3">Binding</dt><dd class="col-sm-9">{{with .Binding}}<code>{{.ChannelType}}:{{.Principal}}</code>{{with .DisplayName}} — {{.}}{{end}}{{with .Provenance}} ({{.}}){{end}}{{else}}Unbound{{end}}</dd></dl></div></section>{{end}}
    <section aria-labelledby="password-heading" class="card mb-3"><div class="card-body"><h2 id="password-heading" class="h4">Rotate password</h2><form method="post" action="/account/password" hx-post="/account/password" hx-target="#main-content"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><div class="row g-3"><div class="col-md-6"><label for="account-current-password" class="form-label">Current password</label><input id="account-current-password" name="current_password" type="password" class="form-control" autocomplete="current-password" required></div><div class="col-md-6"><label for="account-new-password" class="form-label">New password</label><input id="account-new-password" name="new_password" type="password" class="form-control" autocomplete="new-password" minlength="12" maxlength="72" required></div></div><p class="form-text">Rotation revokes every old access and refresh credential, then creates one fresh session family for this browser.</p><button class="btn btn-warning" type="submit">Rotate password</button></form></div></section>
    <section aria-labelledby="sessions-heading" class="card"><div class="card-body"><h2 id="sessions-heading" class="h4">Browser sessions</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Created</th><th scope="col">Last seen</th><th scope="col">Expires</th><th scope="col">State</th><th scope="col">Action</th></tr></thead><tbody>{{range .Sessions}}<tr><td>{{.CreatedAt}}</td><td>{{.LastSeenAt}}</td><td>{{.ExpiresAt}}</td><td>{{.Assurance}}{{if .Current}} <span class="badge text-bg-primary">Current</span>{{end}}{{if .Revoked}} <span class="badge text-bg-secondary">Revoked</span>{{end}}</td><td>{{if not .Revoked}}<form action="/account/sessions/{{.ID}}/revoke" method="post" hx-post="/account/sessions/{{.ID}}/revoke" hx-target="#main-content"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{if .Current}}<div class="form-check"><input class="form-check-input" id="confirm-account-current-{{.ID}}" type="checkbox" name="confirm_current" value="yes"><label class="form-check-label" for="confirm-account-current-{{.ID}}">Confirm current session</label></div>{{end}}<button class="btn btn-sm btn-outline-danger" type="submit">Revoke family</button></form>{{end}}</td></tr>{{else}}<tr><td colspan="5">No sessions.</td></tr>{{end}}</tbody></table></div></div></section>
  </div>
</main>{{end}}
