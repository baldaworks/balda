{{define "content"}}<main hx-history="false" id="main-content" class="app-content" tabindex="-1"><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Your workspace</p><h1>Account</h1><p>Your profile, browser credential and active sessions.</p></div></header>
{{with .Error}}<div class="alert alert-danger" role="alert"><strong>{{.Heading}}</strong> {{.Message}}</div>{{end}}
<div class="detail-grid mb-4">
    {{with .User}}<section aria-labelledby="profile-heading" class="card"><header class="card-header"><h2 id="profile-heading" class="card-title">Profile</h2></header><div class="card-body"><dl class="fact-list"><dt>Display name</dt><dd>{{.DisplayName}}</dd><dt>Username</dt><dd>{{.Username}}</dd><dt>Role</dt><dd>{{.Role}}</dd><dt>Chat bindings</dt><dd>{{range .Bindings}}<div><code>{{.ChannelType}}:{{.Principal}}</code>{{with .DisplayName}} — {{.}}{{end}}{{if eq .ChannelType "telegram"}}<div>Telegram username: {{if .ProviderUsername}}@{{.ProviderUsername}}{{else}}—{{end}}; first name: {{if .ProviderFirstName}}{{.ProviderFirstName}}{{else}}—{{end}}</div>{{end}}</div>{{else}}Unbound{{end}}</dd></dl></div></section>{{end}}
    <section aria-labelledby="password-heading" class="card"><header class="card-header"><h2 id="password-heading" class="card-title">Change password</h2></header><div class="card-body"><form method="post" action="{{path "/"}}account/password" hx-post="{{path "/"}}account/password" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><div class="row g-3"><div class="col-12"><label for="account-current-password" class="form-label">Current password</label><input id="account-current-password" name="current_password" type="password" class="form-control" autocomplete="current-password" required></div><div class="col-12"><label for="account-new-password" class="form-label">New password</label><input id="account-new-password" name="new_password" type="password" class="form-control" autocomplete="new-password" minlength="12" maxlength="72" required></div></div><p class="form-text">Changing the password signs out your other browser sessions.</p><button class="btn btn-primary" type="submit">Change password</button></form></div></section>
</div>
{{with .MFA}}<section class="card mb-4" aria-labelledby="mfa-heading"><header class="card-header"><h2 id="mfa-heading" class="card-title">Two-factor authentication</h2></header><div class="card-body"><p>Optional for each administrator. Status: <strong>{{if .Enabled}}Enabled{{else}}Off{{end}}</strong>.</p>
{{if not .Available}}<p role="status">Passkeys need a supported browser at your configured HTTPS domain or http://localhost. WebAuthn is unavailable at an IP address such as 127.0.0.1. Configure public_url before enabling 2FA.</p>{{else}}
{{if .Enabled}}<p>One active passkey. Registered {{.CreatedAt.Format "2006-01-02 15:04 UTC"}}{{if not .LastUsedAt.IsZero}}; last used {{.LastUsedAt.Format "2006-01-02 15:04 UTC"}}{{end}}.</p>
<form method="post" action="{{path "/account/2fa/replace/start"}}" hx-boost="false" hx-history="false" class="mb-4"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><label for="replace-mfa-password" class="form-label">Current password</label><input id="replace-mfa-password" name="password" type="password" class="form-control mb-3" autocomplete="current-password" required><label class="form-check-label"><input class="form-check-input" type="checkbox" name="confirm" required> Replace my current passkey</label><div class="mt-2"><button class="btn btn-outline-primary" type="submit">Replace passkey</button></div></form>
<form method="post" action="{{path "/account/2fa/disable"}}" hx-boost="false" hx-history="false"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><label for="disable-mfa-password" class="form-label">Current password</label><input id="disable-mfa-password" name="password" type="password" class="form-control mb-3" autocomplete="current-password" required><label class="form-check-label"><input class="form-check-input" type="checkbox" name="confirm" required> Disable two-factor authentication for my account</label><p class="form-text">Other browser sessions will be signed out.</p><button class="btn btn-outline-danger" type="submit">Disable 2FA</button></form>
{{else}}<p>Sign in with your password, then register one passkey with user verification. Other browser sessions will be signed out when you enable it.</p><form method="post" action="{{path "/account/2fa/enable/start"}}" hx-boost="false" hx-history="false"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><label for="enable-mfa-password" class="form-label">Current password</label><input id="enable-mfa-password" name="password" type="password" class="form-control mb-3" autocomplete="current-password" required><button class="btn btn-primary" type="submit">Enable 2FA</button></form>{{end}}{{end}}</div></section>{{end}}
{{template "session_list" .}}
</div></main>{{end}}
