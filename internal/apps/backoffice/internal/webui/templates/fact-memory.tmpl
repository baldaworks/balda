{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false">
<div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{with .FactMemory}}{{if .Editor}}{{if .Editor.New}}Add fact{{else}}Edit fact{{end}}{{else}}Fact memory{{end}}{{else}}Fact memory{{end}}</h1><p>Shared facts used by Balda across all sessions. Changes apply on the next turn.</p></div>{{with .FactMemory}}{{if .Enabled}}{{if .Editor}}<a class="btn btn-outline-secondary" href="{{path "/memory"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All facts</a>{{else}}<a class="btn btn-primary" href="{{path "/memory?new=1"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add fact</a>{{end}}{{end}}{{end}}</header>
{{if .Error}}<div class="alert alert-danger" role="alert" aria-live="polite"><h2 class="h5">{{.Error.Heading}}</h2><p class="mb-0">{{.Error.Message}}</p></div>{{end}}
{{with .FactMemory}}{{if not .Enabled}}<section class="card"><div class="card-body"><p class="mb-0">Fact memory is disabled in configuration. Enable <code>balda.memory.enabled</code> to manage facts.</p></div></section>
{{else if .Editor}}{{template "fact-editor" $}}
{{else}}
<section class="card mb-4"><div class="card-body"><form action="{{path "/memory"}}" method="get" hx-get="{{path "/memory"}}" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true"><label class="form-label" for="fact-query">Search facts</label><div class="action-row"><input class="form-control w-auto flex-grow-1" id="fact-query" type="search" name="q" value="{{.Query}}" placeholder="Find a fact"><button class="btn btn-outline-primary" type="submit">Search</button><a class="btn btn-outline-secondary" href="{{path "/memory"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Clear</a></div></form></div></section>
<section class="card"><header class="card-header"><h2 class="card-title">Facts</h2><span class="count-badge">{{len .Rows}}</span></header><div class="table-responsive" tabindex="0" role="region" aria-label="Fact memory table, horizontally scrollable"><table class="table table-hover access-table"><thead><tr><th scope="col">Fact</th><th scope="col">Actions</th></tr></thead><tbody>
{{range .Rows}}<tr><td class="fact-text-value">{{.Fact}}</td><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Edit<span class="visually-hidden"> fact {{.ID}}</span></a></td></tr>{{else}}<tr><td colspan="2"><span class="empty-table-message">{{if .TotalFacts}}No facts match your search.{{else}}No facts yet.{{end}}</span>{{if .TotalFacts}} <a href="{{path "/memory"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Clear search</a>{{end}}</td></tr>{{end}}
</tbody></table></div></section>
{{end}}{{else}}<div class="alert alert-secondary" role="status">Fact memory is unavailable. Reopen this page to try again.</div>{{end}}
</div></main>{{end}}

{{define "fact-editor"}}{{with .FactMemory.Editor}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">{{if .New}}New fact{{else}}Fact{{end}}</h2></header><div class="card-body"><p>Applies globally on the next turn.</p>{{if $.Error}}{{if .ReopenPath}}<p><a href="{{path .ReopenPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Reopen this fact</a></p>{{end}}{{end}}<form action="{{path .Action}}" method="post" autocomplete="off"{{if .New}} hx-boost="false"{{else}} hx-post="{{path .Action}}" hx-target="#main-content" hx-swap="outerHTML"{{end}}><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{if not .New}}<input type="hidden" name="expected_version" value="{{.ExpectedVersion}}">{{end}}<label class="form-label" for="fact-text">Fact</label><textarea class="form-control" id="fact-text" name="fact" rows="7" placeholder="Enter a fact to remember" required>
{{.Fact}}</textarea><div class="action-row mt-4"><button class="btn btn-primary" type="submit">{{if .New}}Create fact{{else}}Save fact{{end}}</button><a class="btn btn-outline-secondary" href="{{path "/memory"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Cancel</a></div></form></div></section>
{{if not .New}}<section class="card"><header class="card-header"><h2 class="card-title">Delete fact</h2></header><div class="card-body"><p>Deleting removes this fact from current global memory. Conversation history remains.</p><form action="{{path .Action}}/delete" method="post" hx-post="{{path .Action}}/delete" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.ExpectedVersion}}"><div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="fact-confirm-delete" required><label class="form-check-label" for="fact-confirm-delete">Confirm deleting this fact.</label></div><button class="btn btn-outline-danger" type="submit">Delete fact</button></form></div></section>{{end}}
{{end}}{{end}}
