{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false">
<div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{if .Aliases.Editor}}{{if .Aliases.Editor.New}}Add alias{{else}}{{.Aliases.Editor.Row.Name}}{{end}}{{else}}Aliases{{end}}</h1><p>Managed names for report destinations.</p></div>{{if .Aliases.Editor}}<a class="btn btn-outline-secondary" href="{{path "/aliases"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All aliases</a>{{else}}<a class="btn btn-primary" href="{{path "/aliases?new=1"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add alias</a>{{end}}</header>
{{if .Error}}<div class="alert alert-danger" role="alert"><h2 class="h5">{{.Error.Heading}}</h2><p class="mb-0">{{.Error.Message}}</p></div>{{end}}
{{if .Aliases.Editor}}{{with .Aliases.Editor}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">{{if .New}}New alias{{else}}Destination mapping{{end}}</h2></header><div class="card-body"><p>A schedule run or webhook request selects the current locator when accepted. Earlier work keeps the locator it selected.</p><form action="{{path .Action}}" method="post" autocomplete="off"{{if .New}} hx-boost="false"{{else}} hx-post="{{path .Action}}" hx-target="#main-content" hx-swap="outerHTML"{{end}}><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{if not .New}}<input type="hidden" name="expected_version" value="{{.Row.Version}}">{{end}}<div class="row g-3"><div class="col-md-6"><label class="form-label" for="alias-name">Alias name</label>{{if .New}}<input class="form-control" id="alias-name" name="name" pattern="[a-z][a-z0-9_-]*" maxlength="64" placeholder="main_chat" required>{{else}}<input class="form-control" id="alias-name" value="{{.Row.Name}}" readonly>{{end}}<p class="form-text">Lowercase letters, digits, underscores and hyphens; starts with a letter. Names are fixed after creation.</p></div><div class="col-md-6"><label class="form-label" for="alias-locator">Public locator</label><input class="form-control" id="alias-locator" name="locator_ref" value="{{.Row.LocatorRef}}" maxlength="512" placeholder="telegram:-1003953132277:0" required><p class="form-text">Use <code>&lt;channel_type&gt;:&lt;address_key&gt;</code>. The address does not need to exist when this alias is saved.</p></div></div><div class="action-row mt-4"><button class="btn btn-primary" type="submit">{{if .New}}Create alias{{else}}Save destination{{end}}</button></div></form></div></section>
{{if not .New}}<section class="card"><header class="card-header"><h2 class="card-title">Delete alias</h2></header><div class="card-body"><p>Future requests using this name will fail until it is created again. Already accepted work keeps its selected destination.</p><form action="{{path .Action}}/delete" method="post" hx-post="{{path .Action}}/delete" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="alias-confirm-delete" required><label class="form-check-label" for="alias-confirm-delete">Confirm deleting this alias.</label></div><button class="btn btn-outline-danger" type="submit">Delete alias</button></form></div></section>{{end}}
{{end}}{{else}}
<section class="card"><header class="card-header"><h2 class="card-title">Managed destinations</h2><span class="count-badge">{{len .Aliases.Rows}}</span></header><div class="card-body"><p class="text-body-secondary mb-0">An alias is a name for one report locator. Retarget it here to change where future work reports.</p></div><div class="table-responsive" tabindex="0" role="region" aria-label="Aliases table, horizontally scrollable"><table class="table table-hover access-table"><thead><tr><th scope="col">Alias</th><th scope="col">Current locator</th></tr></thead><tbody>{{range .Aliases.Rows}}<tr><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.Name}}</a></td><td class="text-break">{{.LocatorRef}}</td></tr>{{else}}<tr><td colspan="2"><span class="empty-table-message">No aliases yet.</span></td></tr>{{end}}</tbody></table></div></section>
{{end}}
</div></main>{{end}}
