{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid">
    <header class="content-header">
      <div><p class="section-kicker">Administration</p><h1>{{if .CreateUser}}Create user{{else}}Access{{end}}</h1><p>{{if .CreateUser}}Create a browser account with a temporary credential.{{else if .User}}Profile, chat bindings and browser sessions for this user.{{else}}Find users and manage their access to Balda.{{end}}</p></div>
      {{if .User}}<a class="btn btn-outline-secondary" href="{{path "/"}}{{if .Preview}}access-list{{else}}access{{end}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All users</a>{{else if .CreateUser}}<a class="btn btn-outline-secondary" href="{{path "/"}}{{if .Preview}}access-list{{else}}access{{end}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All users</a>{{else}}<a class="btn btn-primary" href="{{path "/"}}{{if .Preview}}access-create{{else}}access/new{{end}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Create user</a>{{end}}
    </header>
    {{with .Error}}<div class="alert alert-danger" role="alert"><strong>{{.Heading}}</strong> {{.Message}}</div>{{end}}

    {{if .CreateUser}}
    <section class="card form-card"><header class="card-header"><h2 class="card-title">New account</h2></header><div class="card-body">
      <p class="text-body-secondary">Create a browser account. Give the temporary password to its owner securely; they must replace it at first sign-in.</p>
      <form action="{{path "/"}}access/users" method="post" hx-post="{{path "/"}}access/users" hx-target="#main-content" hx-swap="outerHTML">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="create-display-name">Display name</label><input class="form-control" id="create-display-name" name="display_name" required></div>
          <div class="col-md-6"><label class="form-label" for="create-username">Username</label><input class="form-control" id="create-username" name="username" autocomplete="off" required></div>
          <div class="col-md-4"><label class="form-label" for="create-role">Role</label><select class="form-select" id="create-role" name="role"><option value="operator">Operator</option><option value="administrator">Administrator</option></select></div>
          <div class="col-md-4"><label class="form-label" for="create-status">Status</label><select class="form-select" id="create-status" name="status"><option value="active">Active</option><option value="disabled">Disabled</option></select></div>
          <div class="col-md-4"><label class="form-label" for="create-password">Temporary password</label><input class="form-control" id="create-password" name="temporary_password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required></div>
        </div>
        <button class="btn btn-primary mt-3" type="submit">Create user</button>
      </form>
    </div></section>
    {{else if .User}}
    {{with .User}}
    <div class="detail-grid mb-4">
    <section class="card"><header class="card-header"><h2 class="card-title">{{.DisplayName}}</h2></header><div class="card-body">
      <p class="mb-3"><span class="status-chip {{if eq .Status "active"}}status-chip--success{{else}}status-chip--danger{{end}}">{{.Status}}</span> <span class="status-chip">{{.Role}}</span> {{if .Primary}}<span class="status-chip status-chip--info">Primary administrator</span>{{end}}</p>
      <dl class="fact-list mb-3"><dt>Username</dt><dd>{{.Username}}</dd><dt>Browser credential</dt><dd>{{.CredentialState}}{{if .MustChange}} · replacement required{{end}}</dd></dl>
      {{if $.OwnUser}}<p><a href="{{path "/"}}account" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Change your own password in Account</a></p>{{end}}
      <details><summary class="btn btn-outline-secondary">Edit profile and access</summary>
        <form class="mt-3" action="{{path "/"}}access/users/{{.ID}}" method="post" hx-post="{{path "/"}}access/users/{{.ID}}" hx-target="#main-content" hx-swap="outerHTML">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Version}}">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label" for="display-name">Display name</label><input class="form-control" id="display-name" name="display_name" value="{{.DisplayName}}" required></div>
            <div class="col-md-6"><label class="form-label" for="username">Username</label><input class="form-control" id="username" name="username" value="{{.Username}}" autocomplete="off" required></div>
            <div class="col-md-6"><label class="form-label" for="role">Role</label><select class="form-select" id="role" name="role" required><option value="administrator"{{if eq .Role "administrator"}} selected{{end}}>Administrator</option><option value="operator"{{if eq .Role "operator"}} selected{{end}}>Operator</option></select></div>
            <div class="col-md-6"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status" required><option value="active"{{if eq .Status "active"}} selected{{end}}>Active</option><option value="disabled"{{if eq .Status "disabled"}} selected{{end}}>Disabled</option></select></div>
          </div>
          {{if .Bindings}}<div class="form-check mt-3"><input class="form-check-input" type="checkbox" id="confirm-bot-impact" name="confirm_bot_impact" value="yes"><label class="form-check-label" for="confirm-bot-impact">I understand that changing role or status can change this user's bot access.</label></div>{{end}}
          <button class="btn btn-primary mt-3" type="submit">Save user</button>
        </form>
      </details>
    </div></section>

    <section class="card"><header class="card-header"><h2 class="card-title">Chat bindings</h2><span class="count-badge">{{len .Bindings}}</span></header><div class="card-body">
      {{range .Bindings}}<article class="channel-stack-item d-block mb-3">
        <p class="mb-1"><strong>{{if eq .ChannelType "slackagent"}}Slack Agent{{else if eq .ChannelType "telegram"}}Telegram{{else if eq .ChannelType "zulip"}}Zulip{{else}}{{.ChannelType}}{{end}}</strong>{{if .DisplayName}} · {{.DisplayName}}{{end}}</p>
        <p class="mb-2 text-body-secondary"><code>{{.Principal}}</code>{{if eq .ChannelType "telegram"}} · username: {{if .ProviderUsername}}@{{.ProviderUsername}}{{else}}unknown{{end}} · first name: {{if .ProviderFirstName}}{{.ProviderFirstName}}{{else}}unknown{{end}}{{end}}</p>
        <details><summary>Remove binding</summary><form class="mt-2" action="{{path "/"}}access/users/{{$.User.ID}}/bindings/{{.ID}}/delete" method="post" hx-post="{{path "/"}}access/users/{{$.User.ID}}/bindings/{{.ID}}/delete" hx-target="#main-content" hx-swap="outerHTML">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{$.User.Version}}">
          <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="confirm-remove-{{.ID}}" name="confirm_bot_impact" value="yes" required><label class="form-check-label" for="confirm-remove-{{.ID}}">Remove this principal's bot access; other bindings and browser sessions stay active.</label></div>
          <button class="btn btn-sm btn-outline-danger" type="submit">Remove binding</button>
        </form></details>
      </article>{{else}}<p class="text-body-secondary">No chat bindings.</p>{{end}}
      {{if $.BindingChoices}}<details class="mt-3"><summary class="btn btn-outline-primary">Add binding</summary>
        <div class="mt-3">{{range $.BindingChoices}}<details class="border rounded p-3 mb-2"><summary>Add {{if eq . "slackagent"}}Slack Agent{{else if eq . "telegram"}}Telegram{{else if eq . "zulip"}}Zulip{{else}}{{.}}{{end}} binding</summary>
          <form class="mt-3" action="{{path "/"}}access/users/{{$.User.ID}}/bindings" method="post" hx-post="{{path "/"}}access/users/{{$.User.ID}}/bindings" hx-target="#main-content" hx-swap="outerHTML">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{$.User.Version}}"><input type="hidden" name="channel_type" value="{{.}}">
            <label class="form-label" for="binding-principal-{{.}}">{{if eq . "slackagent"}}Slack workspace ID:member ID{{else if eq . "telegram"}}Telegram numeric user ID{{else if eq . "zulip"}}Zulip numeric user ID{{end}}</label>
            <input class="form-control" id="binding-principal-{{.}}" name="principal" autocomplete="off" required>
            <p class="form-text">{{if eq . "slackagent"}}Use the workspace team ID and member user ID, for example T123:U456.{{else if eq . "telegram"}}Use the user's positive numeric Telegram ID, not @username.{{else if eq . "zulip"}}Use the user's positive numeric Zulip ID.{{end}}</p>
            <button class="btn btn-primary" type="submit">Add binding</button>
          </form>
        </details>{{end}}</div>
      </details>{{end}}
    </div></section>

    </div>
    <section class="card danger-zone mb-4"><header class="card-header"><h2 class="card-title">Credential</h2></header><div class="card-body"><p>Current state: <strong>{{.CredentialState}}</strong>{{if .MustChange}}; password replacement required{{end}}.</p>
      <details><summary class="btn btn-outline-danger">Reset temporary password</summary>
        <form class="mt-3" action="{{path "/"}}access/users/{{.ID}}/credential" method="post" hx-post="{{path "/"}}access/users/{{.ID}}/credential" hx-target="#main-content" hx-swap="outerHTML">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_user_version" value="{{.Version}}"><input type="hidden" name="expected_credential_version" value="{{.CredentialVersion}}">
          <label class="form-label" for="temporary-password">New temporary password</label><input class="form-control" id="temporary-password" name="temporary_password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required>
          <p class="form-text">Resetting the credential signs this user out of every browser session. They must replace the temporary password on next sign-in.</p>
          <div class="form-check mb-3"><input class="form-check-input" id="confirm-reset-current" type="checkbox" name="confirm_current" value="yes"><label class="form-check-label" for="confirm-reset-current">If this is my account, I understand that my current session will be revoked.</label></div>
          <button class="btn btn-warning" type="submit">Reset credential</button>
        </form>
      </details>
    </div></section>
    {{end}}
    {{template "session_list" .}}
    {{else}}
    <form method="get" action="{{path "/"}}access" hx-get="{{path "/"}}access" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="card mb-3"><div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-md-5"><label class="form-label" for="access-search">Find users</label><input class="form-control" type="search" id="access-search" name="q" value="{{.AccessSearch}}" placeholder="Name or username"></div>
        <div class="col-6 col-md-2"><label class="form-label" for="access-role">Role</label><select class="form-select" id="access-role" name="role"><option value="">All</option><option value="administrator"{{if eq .AccessRole "administrator"}} selected{{end}}>Administrator</option><option value="operator"{{if eq .AccessRole "operator"}} selected{{end}}>Operator</option></select></div>
        <div class="col-6 col-md-2"><label class="form-label" for="access-status">Status</label><select class="form-select" id="access-status" name="status"><option value="">All</option><option value="active"{{if eq .AccessStatus "active"}} selected{{end}}>Active</option><option value="disabled"{{if eq .AccessStatus "disabled"}} selected{{end}}>Disabled</option></select></div>
        <div class="col-12 col-md-3"><button class="btn btn-outline-primary w-100" type="submit">Find users</button></div>
      </div>
    </div></form>
    <section aria-labelledby="users-heading"><p class="small text-body-secondary d-md-none">Swipe the table sideways to see role, status, and chat bindings.</p><div class="card"><header class="card-header"><h2 id="users-heading" class="card-title">Users</h2></header><div class="table-responsive" tabindex="0" role="region" aria-label="Users table, horizontally scrollable"><table class="table table-hover access-table"><thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Chat bindings</th></tr></thead><tbody>
      {{range .Users}}<tr><td><a href="{{path "/"}}access/users/{{.ID}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.DisplayName}}</a><div class="small text-body-secondary">{{.Username}}</div></td><td>{{.Role}}</td><td><span class="status-chip {{if eq .Status "active"}}status-chip--success{{else}}status-chip--danger{{end}}">{{.Status}}</span>{{if .MustChange}} <span class="status-chip status-chip--warning">Must change password</span>{{end}}</td><td>{{if .Bindings}}{{len .Bindings}}{{else}}0{{end}}</td></tr>{{else}}<tr><td colspan="4"><span class="empty-table-message">{{if or .AccessSearch .AccessRole .AccessStatus}}No users match these filters.{{else}}No users yet. Use Create user to add the first account.{{end}}</span></td></tr>{{end}}
    </tbody></table></div></div></section>
    {{end}}
  </div>
</main>{{end}}
