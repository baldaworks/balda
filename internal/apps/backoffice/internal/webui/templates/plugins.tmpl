{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false" data-plugins>
<div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{if .Plugins.MarketplaceAdd}}Add marketplace{{else if .Plugins.MarketplaceDetail}}{{.Plugins.MarketplaceDetail.Row.Name}}{{else}}Plugins{{end}}</h1><p>Manage global plugins and their marketplaces.</p></div>{{if and .Plugins.Marketplaces (not .Plugins.MarketplaceAdd) (not .Plugins.MarketplaceDetail)}}<a class="btn btn-primary" href="{{path "/plugins/marketplaces/new"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add marketplace</a>{{end}}</header>
<nav class="nav nav-tabs mb-4" aria-label="Plugins views"><a class="nav-link{{if not .Plugins.Marketplaces}} active{{end}}"{{if not .Plugins.Marketplaces}} aria-current="page"{{end}} href="{{path "/plugins"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Installed</a><a class="nav-link{{if .Plugins.Marketplaces}} active{{end}}"{{if .Plugins.Marketplaces}} aria-current="page"{{end}} href="{{path "/plugins/marketplaces"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Marketplaces</a></nav>
{{if .Error}}<div class="alert alert-danger" role="alert"><h2 class="h5">{{.Error.Heading}}</h2><p>{{.Error.Message}}</p>{{if .RestartURL}}<a href="{{.RestartURL}}">{{.RestartLabel}}</a>{{end}}</div>{{end}}
{{if .Plugins.Unavailable}}{{else if .Plugins.MarketplaceAdd}}
<section class="card"><header class="card-header"><h2 class="card-title">New marketplace</h2></header><div class="card-body"><form action="{{path "/plugins/marketplaces"}}" method="post" autocomplete="off" data-plugin-marketplace-create hx-post="{{path "/plugins/marketplaces"}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><div class="row g-3"><div class="col-md-5"><label class="form-label" for="plugin-marketplace-name">Name</label><input class="form-control" id="plugin-marketplace-name" name="name" pattern="(?!.*\.\.)[A-Za-z0-9][A-Za-z0-9._\-]{0,63}" maxlength="64" placeholder="team-tools" required><p class="form-text">A unique name for this marketplace.</p></div><div class="col-md-7"><label class="form-label" for="plugin-marketplace-source">Source</label><input class="form-control" id="plugin-marketplace-source" name="source" placeholder="https://example.com/team/plugins.git" autocomplete="off" data-plugin-source required><p class="form-text">A local directory or Git repository. Source is cleared after submission and when leaving this page.</p></div></div><fieldset data-plugin-git-fields hidden disabled class="mt-3"><legend class="h6">Git options</legend><div class="row g-3"><div class="col-md-6"><label class="form-label" for="plugin-marketplace-ref">Ref</label><input class="form-control" id="plugin-marketplace-ref" name="ref" maxlength="256" placeholder="main"><p class="form-text">Optional branch, tag or commit.</p></div><div class="col-md-6"><label class="form-label" for="plugin-marketplace-sparse">Sparse</label><textarea class="form-control" id="plugin-marketplace-sparse" name="sparse" rows="3" placeholder="plugins&#10;.agents/plugins"></textarea><p class="form-text">Optional repository directories, one per line.</p></div></div></fieldset><div class="action-row mt-4"><button class="btn btn-primary" type="submit">Add marketplace</button><a class="btn btn-outline-secondary" href="{{path "/plugins/marketplaces"}}">Cancel</a></div></form></div></section>
{{else if .Plugins.MarketplaceDetail}}{{with .Plugins.MarketplaceDetail}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Marketplace definition</h2></header><div class="card-body"><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9 text-break">{{.Row.Name}}</dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9 text-break">{{.Row.Source}}</dd><dt class="col-sm-3">Ref</dt><dd class="col-sm-9 text-break">{{if .Row.Ref}}{{.Row.Ref}}{{else}}—{{end}}</dd><dt class="col-sm-3">Sparse</dt><dd class="col-sm-9 text-break preserve-lines">{{if .Row.Sparse}}{{.Row.Sparse}}{{else}}—{{end}}</dd><dt class="col-sm-3">Last attempt</dt><dd class="col-sm-9 text-break">{{if .Row.LastAttempt}}{{.Row.LastAttempt}}{{else}}Not refreshed{{end}}</dd><dt class="col-sm-3">Last successful refresh</dt><dd class="col-sm-9 text-break">{{if .Row.LastSuccessful}}{{.Row.LastSuccessful}}{{else}}No successful refresh{{end}}</dd></dl>{{if .FailureMessage}}<div class="alert alert-warning" role="status">{{.FailureMessage}}</div>{{end}}<form action="{{path .Row.DetailPath}}/refresh" method="post" hx-post="{{path .Row.DetailPath}}/refresh" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.Row.ExpectedState}}"><button class="btn btn-primary" type="submit">Refresh marketplace</button></form></div></section>
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Discovered plugins</h2></header>{{if .DiscoveryMessage}}<div class="card-body"><p class="mb-0" role="status">{{.DiscoveryMessage}}</p></div>{{end}}<div class="table-responsive" tabindex="0" role="region" aria-label="Discovered plugins table, horizontally scrollable"><table class="table table-hover"><thead><tr><th scope="col">Name</th><th scope="col">Version</th><th scope="col">Description</th><th scope="col">Review</th></tr></thead><tbody>{{range .Candidates}}<tr><td class="text-break">{{.Name}}</td><td class="text-break">{{.Version}}</td><td class="text-break">{{.Description}}</td><td>{{.ReviewLabel}}{{if .Diagnostic}}<p class="form-text mb-0">{{.Diagnostic}}</p>{{end}}</td></tr>{{else}}<tr><td colspan="4"><span class="empty-table-message">{{if .Row.LastSuccessful}}No plugins discovered.{{else}}Refresh this marketplace to discover plugins.{{end}}</span></td></tr>{{end}}</tbody></table></div></section>
<section class="card"><header class="card-header"><h2 class="card-title">Remove marketplace</h2></header><div class="card-body"><p>Remove this definition from future discovery. Installed plugins and their retained revisions remain available.</p><form action="{{path .Row.DetailPath}}/remove" method="post" hx-post="{{path .Row.DetailPath}}/remove" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.Row.ExpectedState}}"><div class="form-check mb-3"><input class="form-check-input" id="plugin-marketplace-confirm" name="confirm" value="yes" type="checkbox" required><label class="form-check-label" for="plugin-marketplace-confirm">Confirm removing this marketplace.</label></div><div class="action-row"><button class="btn btn-outline-danger" type="submit">Remove marketplace</button><a class="btn btn-outline-secondary" href="{{path "/plugins/marketplaces"}}">Cancel</a></div></form></div></section>
{{end}}{{else if .Plugins.Marketplaces}}
<section class="card"><header class="card-header"><h2 class="card-title">Marketplaces</h2><span class="count-badge">{{len .Plugins.MarketplaceRows}}</span></header><div class="table-responsive" tabindex="0" role="region" aria-label="Marketplaces table, horizontally scrollable"><table class="table table-hover"><thead><tr><th scope="col">Name</th><th scope="col">Source</th><th scope="col">Ref</th><th scope="col">Sparse</th><th scope="col">Last attempt</th></tr></thead><tbody>{{range .Plugins.MarketplaceRows}}<tr><td class="text-break"><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.Name}}</a></td><td class="text-break">{{.Source}}</td><td class="text-break">{{if .Ref}}{{.Ref}}{{else}}—{{end}}</td><td class="text-break preserve-lines">{{if .Sparse}}{{.Sparse}}{{else}}—{{end}}</td><td class="text-break">{{if .LastAttempt}}{{.LastAttempt}}{{else}}Not refreshed{{end}}</td></tr>{{else}}<tr><td colspan="5"><span class="empty-table-message">No marketplaces yet. Add a local directory or Git repository.</span></td></tr>{{end}}</tbody></table></div></section>
{{else}}<section class="card"><header class="card-header"><h2 class="card-title">Installed plugins</h2></header><div class="table-responsive" tabindex="0" role="region" aria-label="Installed plugins table, horizontally scrollable"><table class="table table-hover"><thead><tr><th scope="col">Name</th><th scope="col">Version</th><th scope="col">Marketplace</th><th scope="col">Enabled</th></tr></thead><tbody>{{range .Plugins.InstalledRows}}<tr><td class="text-break">{{.Name}}</td><td class="text-break">{{.Version}}</td><td class="text-break">{{.Marketplace}}</td><td>{{if .Enabled}}Yes{{else}}No{{end}}</td></tr>{{else}}<tr><td colspan="4"><span class="empty-table-message">No installed plugins.</span></td></tr>{{end}}</tbody></table></div></section>{{end}}
</div></main>{{end}}
