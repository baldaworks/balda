{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false" data-plugins>
<div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{if .Plugins.PluginDetail}}{{.Plugins.PluginDetail.Name}}{{else if .Plugins.Review}}{{if .Plugins.Review.Upgrade}}Review upgrade{{else}}Install plugin{{end}}{{else if .Plugins.MarketplaceAdd}}Add marketplace{{else if .Plugins.MarketplaceDetail}}{{.Plugins.MarketplaceDetail.Row.Name}}{{else}}Plugins{{end}}</h1><p>Manage global plugins and their marketplaces.</p></div>{{if and .Plugins.Marketplaces (not .Plugins.MarketplaceAdd) (not .Plugins.MarketplaceDetail)}}<a class="btn btn-primary" href="{{path "/plugins/marketplaces/new"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add marketplace</a>{{end}}{{if and (not .Plugins.Marketplaces) (not .Plugins.PluginDetail) (not .Plugins.Review)}}<a class="btn btn-primary" href="{{path "/plugins/install"}}">Install plugin</a>{{end}}</header>
<nav class="nav nav-tabs mb-4" aria-label="Plugins views"><a class="nav-link{{if not .Plugins.Marketplaces}} active{{end}}"{{if not .Plugins.Marketplaces}} aria-current="page"{{end}} href="{{path "/plugins"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Installed</a><a class="nav-link{{if .Plugins.Marketplaces}} active{{end}}"{{if .Plugins.Marketplaces}} aria-current="page"{{end}} href="{{path "/plugins/marketplaces"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Marketplaces</a></nav>
{{if .Error}}<div class="alert alert-danger" role="alert"><h2 class="h5">{{.Error.Heading}}</h2><p>{{.Error.Message}}</p>{{if .RestartURL}}<a href="{{.RestartURL}}">{{.RestartLabel}}</a>{{end}}</div>{{end}}
{{if .Plugins.Unavailable}}{{else if .Plugins.Review}}{{with .Plugins.Review}}
<section class="card"><header class="card-header"><h2 class="card-title">{{if .Upgrade}}Review upgrade{{else}}Install plugin{{end}}</h2></header><div class="card-body">
{{if not .Upgrade}}<form method="get" action="{{path "/plugins/install"}}"><label class="form-label" for="plugin-marketplace">Marketplace</label><select class="form-select mb-3" id="plugin-marketplace" name="marketplace" required><option value="">Choose marketplace</option>{{range .Marketplaces}}<option value="{{.Name}}"{{if eq .Name $.Plugins.Review.Marketplace}} selected{{end}}>{{.Name}}</option>{{end}}</select>{{if .Marketplace}}<label class="form-label" for="plugin-choice">Plugin</label><select class="form-select mb-3" id="plugin-choice" name="plugin"><option value="">Choose plugin</option>{{range .Candidates}}<option value="{{.Name}}"{{if $.Plugins.Review.Candidate}}{{if eq .Name $.Plugins.Review.Candidate.Name}} selected{{end}}{{end}}>{{.Name}} · {{.Version}}</option>{{end}}</select>{{end}}<button class="btn btn-outline-primary" type="submit">Review selection</button></form>{{if not .Marketplaces}}<p class="mt-3">No marketplaces available. <a href="{{path "/plugins/marketplaces/new"}}">Add marketplace</a>.</p>{{end}}{{if .Marketplace}}<p class="mt-3"><a href="{{path "/plugins/marketplaces/definitions/"}}{{.Marketplace}}">Open marketplace to refresh discovery</a></p>{{end}}{{end}}
{{if .Current}}<dl class="row mt-3"><dt class="col-sm-3">Current Version</dt><dd class="col-sm-9">{{.Current.Version}}</dd><dt class="col-sm-3">Current Revision</dt><dd class="col-sm-9 text-break">{{.Current.Revision}}</dd><dt class="col-sm-3">Enabled</dt><dd class="col-sm-9">{{if .Current.Enabled}}Enabled{{else}}Disabled{{end}}</dd></dl>{{end}}
{{if .ExistingPath}}<p class="mt-3">This plugin is already installed. <a href="{{path .ExistingPath}}">Open installed plugin</a>.</p>{{end}}{{with .Candidate}}<dl class="row mt-3"><dt class="col-sm-3">Name</dt><dd class="col-sm-9 text-break">{{.Name}}</dd><dt class="col-sm-3">Version</dt><dd class="col-sm-9">{{.Version}}</dd><dt class="col-sm-3">Marketplace</dt><dd class="col-sm-9 text-break">{{.Marketplace}}</dd><dt class="col-sm-3">Revision</dt><dd class="col-sm-9 text-break">{{.Revision}}</dd><dt class="col-sm-3">Capabilities</dt><dd class="col-sm-9">{{.Capabilities.Commands}} commands · {{.Capabilities.Skills}} skills · {{.Capabilities.MCPServers}} MCP servers · {{.Capabilities.Diagnostics}} diagnostics</dd></dl><p class="text-break">{{.Description}}</p>{{if $.Plugins.Review.CandidateDiagnostics}}<ul>{{range $.Plugins.Review.CandidateDiagnostics}}<li>{{.}}</li>{{end}}</ul>{{end}}
<form action="{{path $.Plugins.Review.ActionPath}}" method="post" hx-post="{{path $.Plugins.Review.ActionPath}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.ExpectedState}}"><input type="hidden" name="candidate_token" value="{{.CandidateToken}}">{{if not $.Plugins.Review.Upgrade}}<input type="hidden" name="plugin_name" value="{{.Name}}"><input type="hidden" name="marketplace_name" value="{{.Marketplace}}">{{end}}<div class="action-row"><button class="btn btn-primary" type="submit">{{if $.Plugins.Review.Upgrade}}Upgrade plugin{{else}}Install plugin{{end}}</button><a class="btn btn-outline-secondary" href="{{if $.Plugins.Review.Current}}{{path $.Plugins.Review.Current.DetailPath}}{{else}}{{path "/plugins"}}{{end}}">Cancel</a></div></form>{{end}}
<p class="form-text mt-3">Changes apply to new sessions. Existing and restored sessions keep their exact snapshot until an explicit normal Reset.</p></div></section>{{end}}
{{else if .Plugins.PluginDetail}}{{with .Plugins.PluginDetail}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Plugin detail</h2></header><div class="card-body"><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9 text-break">{{.Name}}</dd><dt class="col-sm-3">Version</dt><dd class="col-sm-9">{{.Version}}</dd><dt class="col-sm-3">Marketplace</dt><dd class="col-sm-9 text-break">{{.Marketplace}}</dd><dt class="col-sm-3">Revision</dt><dd class="col-sm-9 text-break">{{.Revision}}</dd><dt class="col-sm-3">Enabled</dt><dd class="col-sm-9">{{if .Enabled}}Enabled{{else}}Disabled{{end}}</dd><dt class="col-sm-3">Origin availability</dt><dd class="col-sm-9">{{if .OriginAvailable}}Available{{else}}Unavailable: upgrade cannot be reviewed{{end}}</dd><dt class="col-sm-3">Activation outcome</dt><dd class="col-sm-9">{{if .RecoveryPending}}Accepted; recovery pending{{else}}No pending activation{{end}}{{if .Removed}} · Removed current selection{{end}}</dd><dt class="col-sm-3">Current catalog</dt><dd class="col-sm-9">{{.CurrentCatalog}}</dd><dt class="col-sm-3">Runtime health</dt><dd class="col-sm-9">{{.RuntimeHealth}}{{if .Runtime.RevisionCurrent}} · {{.Runtime.ReadyMCPServers}}/{{.Runtime.DesiredMCPServers}} MCP attachments ready · {{.Runtime.DegradedMCPServers}} degraded{{end}}</dd></dl>{{if .Diagnostics}}<h3 class="h6">Diagnostics</h3><ul>{{range .Diagnostics}}<li>{{.}}</li>{{end}}</ul>{{end}}<p class="form-text">Changes apply to new sessions. Existing and restored sessions keep their exact snapshot until an explicit normal Reset.</p>
{{if and (not .Removed) (not .RecoveryPending) (not .MutationBlocked)}}{{if .OriginAvailable}}<a class="btn btn-outline-primary" href="{{path .DetailPath}}/upgrade">Review upgrade</a>{{else}}<p>Upgrade unavailable: the locked origin cannot be verified or discovered.</p>{{end}}
{{if or .Enabled .CanEnable}}<form class="mt-3" action="{{path .DetailPath}}{{if .Enabled}}/disable{{else}}/enable{{end}}" method="post" hx-post="{{path .DetailPath}}{{if .Enabled}}/disable{{else}}/enable{{end}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.ExpectedState}}">{{if .Enabled}}<div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="plugin-disable-confirm" required><label class="form-check-label" for="plugin-disable-confirm">Confirm disabling {{.Name}} for new sessions.</label></div>{{end}}<div class="action-row"><button class="btn btn-outline-primary" type="submit">{{if .Enabled}}Disable plugin{{else}}Enable plugin{{end}}</button><a href="{{path .DetailPath}}">Cancel</a></div></form>{{else}}<p class="mt-3">Enable unavailable: the selected revision is not available.</p>{{end}}{{end}}</div></section>
{{range .ContributionTables}}{{$kind := .Label}}{{$items := .Items}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">{{$kind}}</h2></header><div class="table-responsive" tabindex="0" role="region" aria-label="{{$kind}} table, horizontally scrollable"><table class="table"><thead><tr><th scope="col">Name</th><th scope="col">{{if eq $kind "MCP servers"}}Transport{{else}}Description{{end}}</th></tr></thead><tbody>{{range $items}}<tr><td class="text-break">{{.Name}}</td><td class="text-break">{{if eq $kind "MCP servers"}}{{.Transport}}{{else}}{{.Description}}{{end}}</td></tr>{{else}}<tr><td colspan="2">No contributions.</td></tr>{{end}}</tbody></table></div></section>{{end}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Retained revisions</h2></header><div class="card-body"><p class="mb-0">Rollback preserves the Enabled state.</p></div><div class="table-responsive" tabindex="0" role="region" aria-label="Retained revisions table, horizontally scrollable"><table class="table"><thead><tr><th scope="col">Version</th><th scope="col">Revision</th><th scope="col">Retained at</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Revisions}}<tr><td>{{.Version}}</td><td class="text-break">{{.Revision}}</td><td>{{if not .RetainedAt.IsZero}}{{.RetainedAt.UTC.Format "2006-01-02 15:04:05 UTC"}}{{else}}—{{end}}</td><td>{{if .Current}}Selected{{else if .Available}}Available{{else}}Unavailable{{end}}</td><td>{{if and .Available (not .Current) (not $.Plugins.PluginDetail.Removed) (not $.Plugins.PluginDetail.RecoveryPending) (not $.Plugins.PluginDetail.MutationBlocked)}}<form action="{{path $.Plugins.PluginDetail.DetailPath}}/rollback" method="post" hx-post="{{path $.Plugins.PluginDetail.DetailPath}}/rollback" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{$.Plugins.PluginDetail.ExpectedState}}"><input type="hidden" name="revision" value="{{.Revision}}"><div class="form-check"><input class="form-check-input" type="checkbox" name="confirm" value="yes" required aria-label="Confirm rollback to {{.Revision}}"><label class="form-check-label">Confirm rollback to <span class="text-break">{{.Revision}}</span></label></div><button class="btn btn-sm btn-outline-primary mt-2" type="submit">Rollback</button> <a href="{{path $.Plugins.PluginDetail.DetailPath}}">Cancel</a></form>{{else}}—{{end}}</td></tr>{{else}}<tr><td colspan="5">No retained revisions.</td></tr>{{end}}</tbody></table></div></section>
{{if and (not .Removed) (not .RecoveryPending) (not .MutationBlocked)}}<section class="card"><header class="card-header"><h2 class="card-title">Remove plugin</h2></header><div class="card-body"><p>Remove {{.Name}} from new session catalogs. Data and retained revisions remain available to existing sessions.</p><form action="{{path .DetailPath}}/remove" method="post" hx-post="{{path .DetailPath}}/remove" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.ExpectedState}}"><div class="form-check mb-3"><input class="form-check-input" id="plugin-remove-confirm" name="confirm" value="yes" type="checkbox" required><label class="form-check-label" for="plugin-remove-confirm">Confirm removing {{.Name}}.</label></div><div class="action-row"><button class="btn btn-outline-danger" type="submit">Remove plugin</button><a class="btn btn-outline-secondary" href="{{path .DetailPath}}">Cancel</a></div></form></div></section>{{end}}
{{end}}
{{else if .Plugins.MarketplaceAdd}}
<section class="card"><header class="card-header"><h2 class="card-title">New marketplace</h2></header><div class="card-body"><form action="{{path "/plugins/marketplaces"}}" method="post" autocomplete="off" data-plugin-marketplace-create hx-post="{{path "/plugins/marketplaces"}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><div class="row g-3"><div class="col-md-5"><label class="form-label" for="plugin-marketplace-name">Name</label><input class="form-control" id="plugin-marketplace-name" name="name" pattern="(?!.*\.\.)[A-Za-z0-9][A-Za-z0-9._\-]{0,63}" maxlength="64" placeholder="team-tools" required><p class="form-text">A unique name for this marketplace.</p></div><div class="col-md-7"><label class="form-label" for="plugin-marketplace-source">Source</label><input class="form-control" id="plugin-marketplace-source" name="source" placeholder="https://example.com/team/plugins.git" autocomplete="off" data-plugin-source required><p class="form-text">A local directory or Git repository. Source is cleared after submission and when leaving this page.</p></div></div><fieldset data-plugin-git-fields hidden disabled class="mt-3"><legend class="h6">Git options</legend><div class="row g-3"><div class="col-md-6"><label class="form-label" for="plugin-marketplace-ref">Ref</label><input class="form-control" id="plugin-marketplace-ref" name="ref" maxlength="256" placeholder="main"><p class="form-text">Optional branch, tag or commit.</p></div><div class="col-md-6"><label class="form-label" for="plugin-marketplace-sparse">Sparse</label><textarea class="form-control" id="plugin-marketplace-sparse" name="sparse" rows="3" placeholder="plugins&#10;.agents/plugins"></textarea><p class="form-text">Optional repository directories, one per line.</p></div></div></fieldset><div class="action-row mt-4"><button class="btn btn-primary" type="submit">Add marketplace</button><a class="btn btn-outline-secondary" href="{{path "/plugins/marketplaces"}}">Cancel</a></div></form></div></section>
{{else if .Plugins.MarketplaceDetail}}{{with .Plugins.MarketplaceDetail}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Marketplace definition</h2></header><div class="card-body"><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9 text-break">{{.Row.Name}}</dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9 text-break">{{.Row.Source}}</dd><dt class="col-sm-3">Ref</dt><dd class="col-sm-9 text-break">{{if .Row.Ref}}{{.Row.Ref}}{{else}}—{{end}}</dd><dt class="col-sm-3">Sparse</dt><dd class="col-sm-9 text-break preserve-lines">{{if .Row.Sparse}}{{.Row.Sparse}}{{else}}—{{end}}</dd><dt class="col-sm-3">Available plugins</dt><dd class="col-sm-9">{{.Row.AvailablePlugins}}</dd><dt class="col-sm-3">Resolved revision</dt><dd class="col-sm-9 text-break">{{if .Row.ResolvedRevision}}{{.Row.ResolvedRevision}}{{else}}—{{end}}</dd><dt class="col-sm-3">Last attempt</dt><dd class="col-sm-9 text-break">{{if .Row.LastAttempt}}{{.Row.LastAttempt}}{{else}}Not refreshed{{end}}</dd><dt class="col-sm-3">Last successful refresh</dt><dd class="col-sm-9 text-break">{{if .Row.LastSuccessful}}{{.Row.LastSuccessful}}{{else}}No successful refresh{{end}}</dd></dl>{{if .FailureMessage}}<div class="alert alert-warning" role="status">{{.FailureMessage}}</div>{{end}}<form action="{{path .Row.DetailPath}}/refresh" method="post" hx-post="{{path .Row.DetailPath}}/refresh" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.Row.ExpectedState}}"><button class="btn btn-primary" type="submit">Refresh marketplace</button></form></div></section>
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Discovered plugins</h2></header>{{if .DiscoveryMessage}}<div class="card-body"><p class="mb-0" role="status">{{.DiscoveryMessage}}</p></div>{{end}}<div class="table-responsive" tabindex="0" role="region" aria-label="Discovered plugins table, horizontally scrollable"><table class="table table-hover"><thead><tr><th scope="col">Name</th><th scope="col">Version</th><th scope="col">Description</th><th scope="col">Installed</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Candidates}}<tr><td class="text-break">{{.Name}}</td><td class="text-break">{{.Version}}</td><td class="text-break">{{.Description}}</td><td>{{if .Installed}}Yes{{else}}No{{end}}</td><td>{{if .Installed}}<a href="{{path .InstalledPath}}">Open installed</a>{{else if .CandidateToken}}{{.ReviewLabel}} · <a href="{{path "/plugins/install"}}?marketplace={{urlquery $.Plugins.MarketplaceDetail.Row.Name}}&amp;plugin={{urlquery .Name}}">Review install</a>{{else}}{{.ReviewLabel}}{{end}}{{if .Diagnostic}}<p class="form-text mb-0">{{.Diagnostic}}</p>{{end}}</td></tr>{{else}}<tr><td colspan="5"><span class="empty-table-message">{{if .Row.LastSuccessful}}No plugins discovered.{{else}}Refresh this marketplace to discover plugins.{{end}}</span></td></tr>{{end}}</tbody></table></div></section>
<section class="card"><header class="card-header"><h2 class="card-title">Remove marketplace</h2></header><div class="card-body"><p>Remove this definition from future discovery. Installed plugins and their retained revisions remain available.</p><form action="{{path .Row.DetailPath}}/remove" method="post" hx-post="{{path .Row.DetailPath}}/remove" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.Row.ExpectedState}}"><div class="form-check mb-3"><input class="form-check-input" id="plugin-marketplace-confirm" name="confirm" value="yes" type="checkbox" required><label class="form-check-label" for="plugin-marketplace-confirm">Confirm removing this marketplace.</label></div><div class="action-row"><button class="btn btn-outline-danger" type="submit">Remove marketplace</button><a class="btn btn-outline-secondary" href="{{path "/plugins/marketplaces"}}">Cancel</a></div></form></div></section>
{{end}}{{else if .Plugins.Marketplaces}}
<section class="card"><header class="card-header"><h2 class="card-title">Marketplaces</h2><span class="count-badge">{{len .Plugins.MarketplaceRows}}</span></header><div class="table-responsive" tabindex="0" role="region" aria-label="Marketplaces table, horizontally scrollable"><table class="table table-hover"><thead><tr><th scope="col">Name</th><th scope="col">Source</th><th scope="col">Ref</th><th scope="col">Sparse</th><th scope="col">Discovery</th><th scope="col">Available plugins</th><th scope="col">Last successful refresh</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Plugins.MarketplaceRows}}<tr><td class="text-break"><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.Name}}</a></td><td class="text-break">{{.Source}}</td><td class="text-break">{{if .Ref}}{{.Ref}}{{else}}—{{end}}</td><td class="text-break preserve-lines">{{if .Sparse}}{{.Sparse}}{{else}}—{{end}}</td><td class="text-break">{{if .LastAttempt}}{{.LastAttempt}}{{else}}Not refreshed{{end}}</td><td>{{.AvailablePlugins}}</td><td>{{if .LastSuccessful}}{{.LastSuccessful}}{{else}}No successful refresh{{end}}</td><td><a href="{{path .DetailPath}}">Open</a></td></tr>{{else}}<tr><td colspan="8"><span class="empty-table-message">No marketplaces yet. Add a local directory or Git repository.</span></td></tr>{{end}}</tbody></table></div></section>
{{else}}<section class="card"><header class="card-header"><h2 class="card-title">Installed plugins</h2></header><div class="table-responsive" tabindex="0" role="region" aria-label="Installed plugins table, horizontally scrollable"><table class="table table-hover"><thead><tr><th scope="col">Name</th><th scope="col">Version</th><th scope="col">Marketplace</th><th scope="col">Enabled</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Plugins.InstalledRows}}<tr><td class="text-break">{{.Name}}</td><td class="text-break">{{.Version}}</td><td class="text-break">{{.Marketplace}}</td><td>{{if .Enabled}}Enabled{{else}}Disabled{{end}}{{if .RecoveryPending}} · Recovery pending{{end}}</td><td><a href="{{path "/plugins/installed/"}}{{.Name}}">Open</a></td></tr>{{else}}<tr><td colspan="5"><span class="empty-table-message">No installed plugins.</span></td></tr>{{end}}</tbody></table></div></section>{{end}}
</div></main>{{end}}
