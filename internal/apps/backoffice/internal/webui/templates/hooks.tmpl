{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false" data-agent-hooks><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{with .Hooks}}{{if .Editor}}{{if .Editor.New}}Add agent hook{{else}}Edit agent hook{{end}}{{else}}Agent hooks{{end}}{{else}}Agent hooks{{end}}</h1><p>Run approved commands at agent lifecycle events. Changes apply to the next matching event.</p></div><a class="btn btn-outline-secondary" href="{{path "/hooks"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All hooks</a></header>
{{with .Error}}<div class="alert alert-danger" role="alert" aria-live="polite"><h2 class="h5">{{.Heading}}</h2><p class="mb-0">{{.Message}}</p></div>{{end}}
{{with .Hooks}}{{if .Editor}}{{template "hook-editor" $}}{{else}}
<div class="action-row mb-4"><a class="btn btn-primary" href="{{path "/hooks?new=1"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add hook</a></div>
<section class="card"><header class="card-header"><h2 class="card-title">Agent hooks</h2><span class="count-badge">{{len .Rows}}</span></header><div class="table-responsive" tabindex="0" role="region" aria-label="Agent hooks table, horizontally scrollable"><table class="table table-hover"><thead><tr><th scope="col">Name</th><th scope="col">Event</th><th scope="col">Provider</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Rows}}<tr><td class="text-break">{{.Name}}</td><td>{{.Event}}</td><td>{{if .Provider}}{{.Provider}}{{else}}All providers{{end}}</td><td>{{if .Enabled}}Enabled{{else}}Disabled{{end}}</td><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Edit<span class="visually-hidden"> {{.Name}}</span></a></td></tr>{{else}}<tr><td colspan="5"><span class="empty-table-message">No agent hooks yet.</span></td></tr>{{end}}</tbody></table></div></section>
{{end}}{{else}}<div class="alert alert-secondary" role="status">Agent hooks are unavailable. Reopen this page to try again.</div>{{end}}
</div></main>{{end}}

{{define "hook-editor"}}{{with .Hooks.Editor}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">Hook configuration</h2></header><div class="card-body">
<p>Enabled commands run with the operating-system permissions of Balda. Event data is supplied as JSON on standard input. Commands run in name order.</p>
{{if $.Error}}<p><a href="{{path .ReopenPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Reopen this hook</a></p>{{end}}
<form action="{{path .Action}}" method="post" autocomplete="off" hx-post="{{path .Action}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.ExpectedVersion}}">
<div class="mb-3"><label class="form-label" for="hook-name">Name</label><input class="form-control" id="hook-name" name="name" value="{{.Definition.Name}}" maxlength="64" pattern="[a-z][a-z0-9-]*" required{{if not .New}} readonly{{end}}></div>
<div class="mb-3"><label class="form-label" for="hook-event">Event</label><select class="form-select" id="hook-event" name="event">{{$event := .Definition.Event}}{{range $.Hooks.Events}}<option value="{{.}}"{{if eq . $event}} selected{{end}}>{{.}}</option>{{end}}</select></div>
<div class="mb-3"><label class="form-label" for="hook-command">Executable</label><input class="form-control" id="hook-command" name="command" value="{{.Definition.Command}}" maxlength="4096" placeholder="/usr/bin/python3" required><p class="form-text">Use an executable path or a command available in Balda's PATH.</p></div>
<div class="mb-3"><label class="form-label" for="hook-args">Arguments</label><textarea class="form-control" id="hook-args" name="args" rows="4" required>{{.ArgsJSON}}</textarea><p class="form-text">A JSON array of strings, for example ["/opt/balda/hooks/check.py"]. Prompt text is never substituted into command arguments.</p></div>
<div class="mb-3"><label class="form-label" for="hook-provider">Provider ID — optional</label><input class="form-control" id="hook-provider" name="provider" value="{{.Definition.Provider}}" maxlength="128"><p class="form-text">Leave empty to match all providers, or enter the configured Balda provider ID.</p></div>
<div class="mb-3"><label class="form-label" for="hook-matcher">Source matcher — optional</label><input class="form-control" id="hook-matcher" name="matcher" value="{{.Definition.Matcher}}" maxlength="256"><p class="form-text">Regular expression for the event source. Leave empty to match every source.</p></div>
<div class="mb-3"><label class="form-label" for="hook-timeout">Timeout in seconds</label><input class="form-control" id="hook-timeout" name="timeout_seconds" type="number" min="1" max="120" value="{{.Definition.TimeoutSeconds}}" required></div>
<div class="form-check mb-4"><input class="form-check-input" id="hook-enabled" name="enabled" type="checkbox" value="yes"{{if .Definition.Enabled}} checked{{end}}><label class="form-check-label" for="hook-enabled">Enable this hook</label></div>
<div class="action-row"><button class="btn btn-primary" type="submit">{{if .New}}Create hook{{else}}Save hook{{end}}</button><a class="btn btn-outline-secondary" href="{{path "/hooks"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Cancel</a></div></form></div></section>
{{if not .New}}<section class="card"><header class="card-header"><h2 class="card-title">Delete hook</h2></header><div class="card-body"><p>Removes this definition. Hook invocations already running finish with their selected configuration.</p><form action="{{path .Action}}/delete" method="post" hx-post="{{path .Action}}/delete" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.ExpectedVersion}}"><div class="form-check mb-3"><input class="form-check-input" id="hook-confirm-delete" name="confirm" type="checkbox" value="yes" required><label class="form-check-label" for="hook-confirm-delete">Confirm deleting this hook.</label></div><button class="btn btn-outline-danger" type="submit">Delete hook</button></form></div></section>{{end}}
{{end}}{{end}}
