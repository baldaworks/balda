{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false">
  <div class="container-fluid">
    <header class="content-header"><div><p class="section-kicker">Administration</p><h1>{{if .MCP.Device}}Worker authorization{{else if .MCP.Editor}}{{if .MCP.Editor.New}}Add MCP server{{else}}{{.MCP.Editor.PublicID}}{{end}}{{else}}MCP servers{{end}}</h1><p>{{if .MCP.Device}}Authorize the worker and inspect its progress.{{else}}Manage tool connections and inspect their current readiness.{{end}}</p></div>{{if or .MCP.Editor .MCP.Device}}<a class="btn btn-outline-secondary" href="{{path "/mcp"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All MCP servers</a>{{else}}<a class="btn btn-primary" href="{{path "/mcp/new"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Add server</a>{{end}}</header>
    {{if .Error}}<div class="alert alert-danger" role="alert"><h2 class="h5">{{.Error.Heading}}</h2><p class="mb-0">{{.Error.Message}}</p></div>{{end}}
    {{with .MCP.ProbeMessage}}<div class="alert alert-info" role="status">{{.}}</div>{{end}}
    {{if .MCP.Device}}
      {{template "mcp-device" .}}
    {{else if .MCP.Editor}}
      {{template "mcp-editor" .}}
    {{else}}
    <section class="card"><header class="card-header"><h2 class="card-title">Connections</h2><span class="count-badge">{{len .MCP.Rows}}</span></header>
      <div class="card-body"><p class="text-body-secondary mb-0">Saved definitions and authorized worker grants become ready only after their tools are available. Configuration entries are read-only.</p></div>
      <div class="table-responsive" tabindex="0" role="region" aria-label="MCP connections table, horizontally scrollable"><table class="table table-hover access-table"><thead><tr><th scope="col">Server</th><th scope="col">Source and transport</th><th scope="col">Providers</th><th scope="col">Runtime</th><th scope="col">Worker authorization</th></tr></thead><tbody>
        {{range .MCP.Rows}}<tr><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.PublicID}}</a><div class="small text-body-secondary text-break">{{.Endpoint}}</div></td><td>{{.Source}}<div class="small text-body-secondary">{{.Transport}}{{if .ReadOnly}} · Read-only{{end}}</div></td><td>{{.Targets}}</td><td><span class="status-chip {{if .Ready}}status-chip--success{{else}}status-chip--warning{{end}}">{{.Status}}</span>{{if .Ready}}<div class="small text-body-secondary">{{.ToolCount}} tools</div>{{end}}</td><td>{{if .Authorization}}{{.Authorization}}{{else}}—{{end}}{{if .Recovery}}<p class="small mt-1 mb-0">{{.Recovery}}</p>{{end}}</td></tr>{{else}}<tr><td colspan="5"><span class="empty-table-message">No MCP servers yet. Add a server or declare one in the host configuration.</span></td></tr>{{end}}
      </tbody></table></div>
    </section>
    {{end}}
  </div>
</main>{{end}}

{{define "mcp-editor"}}
{{with .MCP.Editor}}
{{if not .New}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">Current state</h2><a href="{{path .Row.DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Refresh state</a></header><div class="card-body">
  <dl class="fact-list"><dt>Source</dt><dd>{{.Row.Source}}{{if .Row.ReadOnly}} · Read-only{{end}}</dd><dt>Provider targets</dt><dd>{{.Row.Targets}}</dd><dt>Runtime</dt><dd><span class="status-chip {{if .Row.Ready}}status-chip--success{{else}}status-chip--warning{{end}}">{{.Row.Status}}</span>{{if .Row.Ready}} · {{.Row.ToolCount}} tools{{end}}</dd><dt>Worker authorization</dt><dd>{{if .Row.Authorization}}{{.Row.Authorization}}{{else}}No current worker grant{{end}}</dd>{{if .Row.Recovery}}<dt>Recovery</dt><dd>{{.Row.Recovery}}</dd>{{end}}</dl>
  <p class="form-text mb-0">Saving a definition or authorizing a worker grant does not make a connection Ready. Ready means the selected revision's tools are available.</p>
</div></section>
{{end}}
{{if .AuthorizationAvailable}}{{template "mcp-authorization" $}}{{end}}
{{if .Row.Deleted}}
<section class="card"><header class="card-header"><h2 class="card-title">Retained definition</h2></header><div class="card-body"><p>This connection was deleted. Its revisions remain available to existing sessions until they are released.</p><dl class="fact-list"><dt>Source</dt><dd>{{.Row.Source}}</dd><dt>Transport</dt><dd>{{.Transport}}</dd><dt>Endpoint or command</dt><dd class="text-break">{{.Row.Endpoint}}</dd></dl></div></section>
{{else if .Row.ReadOnly}}
<section class="card"><header class="card-header"><h2 class="card-title">Configuration definition</h2></header><div class="card-body"><p>Edit this definition in the host configuration. Browser editing, selection changes and deletion are unavailable.</p><dl class="fact-list"><dt>Transport</dt><dd>{{.Transport}}</dd><dt>Endpoint or command</dt><dd class="text-break">{{.Row.Endpoint}}</dd></dl>{{range .Env}}<p class="text-break mb-1">Environment key <code>{{.Key}}</code> · {{.Kind}}</p>{{end}}{{range .Headers}}<p class="text-break mb-1">Header <code>{{.Key}}</code> · {{.Kind}}</p>{{end}}</div></section>
{{else}}
<section class="card mb-4"><header class="card-header"><h2 class="card-title">{{if .New}}New connection{{else}}Edit definition{{end}}</h2></header><div class="card-body">
<form action="{{path .Action}}" method="post" hx-post="{{path .Action}}" hx-target="#main-content" hx-swap="outerHTML" autocomplete="off">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{if not .New}}<input type="hidden" name="expected_version" value="{{.Row.Version}}">{{end}}
<div class="row g-3">
<div class="col-md-6"><label class="form-label" for="mcp-public-id">Server ID</label>{{if .New}}<input class="form-control" id="mcp-public-id" name="public_id" pattern="[A-Za-z0-9][A-Za-z0-9._\-]*" maxlength="128" required>{{else}}<input class="form-control" id="mcp-public-id" value="{{.PublicID}}" readonly>{{end}}<p class="form-text">The server ID is immutable after creation and must be unique across configuration and Backoffice.</p></div>
<div class="col-md-6"><label class="form-label" for="mcp-transport">Transport</label><select class="form-select" id="mcp-transport" name="transport"><option value="stdio"{{if eq .Transport "stdio"}} selected{{end}}>Local process (stdio)</option><option value="http"{{if eq .Transport "http"}} selected{{end}}>Streamable HTTP</option><option value="sse"{{if eq .Transport "sse"}} selected{{end}}>SSE</option></select></div>
</div>
<fieldset class="mt-4"><legend class="h5">Local process</legend><p class="form-text">For stdio only; clear these fields for a remote server. Commands and arguments are passed directly; each argument occupies one line.</p><div class="row g-3"><div class="col-md-6"><label class="form-label" for="mcp-command">Command</label><input class="form-control" id="mcp-command" name="command" value="{{.Command}}"></div><div class="col-md-6"><label class="form-label" for="mcp-directory">Working directory</label><input class="form-control" id="mcp-directory" name="directory" value="{{.Directory}}"></div><div class="col-12"><label class="form-label" for="mcp-args">Arguments · one per line</label><textarea class="form-control" id="mcp-args" name="args" rows="3">{{.Args}}</textarea></div></div></fieldset>
<fieldset class="mt-4"><legend class="h5">Remote server</legend><p class="form-text">For HTTP and SSE only; clear these fields and OAuth settings for stdio. Keep credentials out of the URL; use a protected header or deployment variable.</p><label class="form-label" for="mcp-url">Server URL</label><input class="form-control" id="mcp-url" name="url" type="url" value="{{.URL}}"><div class="form-check mt-3"><input class="form-check-input" id="mcp-oauth" name="oauth" value="yes" type="checkbox"{{if .OAuth}} checked{{end}}><label class="form-check-label" for="mcp-oauth">Use worker OAuth</label></div><label class="form-label mt-3" for="mcp-scopes">OAuth scopes · one per line</label><textarea class="form-control" id="mcp-scopes" name="scopes" rows="2">{{.Scopes}}</textarea></fieldset>
<fieldset class="mt-4"><legend class="h5">Provider targets</legend><div class="form-check"><input class="form-check-input" id="mcp-all" name="targets_all" value="yes" type="checkbox"{{if .All}} checked{{end}}><label class="form-check-label" for="mcp-all">All providers</label></div><p class="form-text">Choose all providers or selected providers below. Clear individual selections when using all providers.</p>{{range $index,$provider:=.Providers}}<div class="form-check"><input class="form-check-input" id="mcp-provider-{{$index}}" name="provider" value="{{.ID}}" type="checkbox"{{if .Selected}} checked{{end}}><label class="form-check-label text-break" for="mcp-provider-{{$index}}">{{.ID}}</label></div>{{end}}</fieldset>
<fieldset class="mt-4"><legend class="h5">Environment values</legend><p class="form-text">Used for stdio. Existing values are never filled in. Keep retains the stored value; Replace sets it; Remove deletes it. A deployment variable is an explicit variable name, not an interpolation expression. Save and reopen to add more rows.</p>{{range $index,$row:=.Env}}{{template "mcp-value" (valueRow $row "env" $index)}}{{end}}</fieldset>
<fieldset class="mt-4"><legend class="h5">Headers</legend><p class="form-text">Used for HTTP and SSE. Protected values are encrypted and write-only. Remove incompatible values when changing transport. Leave unused new keys blank.</p>{{range $index,$row:=.Headers}}{{template "mcp-value" (valueRow $row "header" $index)}}{{end}}</fieldset>
<div class="form-check mt-4"><input class="form-check-input" id="mcp-enabled" name="enabled" type="checkbox" value="yes"{{if .Enabled}} checked{{end}}><label class="form-check-label" for="mcp-enabled">Enabled for new provider sessions</label></div><p class="form-text">Existing sessions retain their selected revision. A candidate probe discovers tools without saving or selecting this definition. Probe inputs are cleared afterwards.</p>
<div class="action-row mt-3"><button class="btn btn-primary" name="operation" value="save" type="submit">{{if .New}}Create server{{else}}Save definition{{end}}</button><button class="btn btn-outline-secondary" name="operation" value="probe" type="submit">Probe candidate</button></div>
</form></div></section>
{{if not .New}}
<section class="card danger-zone"><header class="card-header"><h2 class="card-title">Selection and deletion</h2></header><div class="card-body"><p>Changes apply to new sessions. Existing sessions retain their exact revision and release it when they end.</p>
<form class="mb-4" action="{{path .Action}}/selection" method="post" hx-post="{{path .Action}}/selection" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}">{{if not .Enabled}}<input type="hidden" name="enabled" value="yes">{{end}}<div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="mcp-confirm-selection" required><label class="form-check-label" for="mcp-confirm-selection">Confirm {{if .Enabled}}disabling{{else}}enabling{{end}} this connection for new sessions.</label></div><button class="btn btn-outline-warning" type="submit">{{if .Enabled}}Disable{{else}}Enable{{end}} connection</button></form>
<form action="{{path .Action}}/delete" method="post" hx-post="{{path .Action}}/delete" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.Row.Version}}"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirm" value="yes" id="mcp-confirm-delete" required><label class="form-check-label" for="mcp-confirm-delete">Confirm removing this connection from new sessions. Retained revisions are not erased.</label></div><button class="btn btn-outline-danger" type="submit">Delete connection</button></form>
</div></section>{{end}}
{{end}}
{{end}}
{{end}}

{{define "mcp-value"}}<div class="row g-2 mb-3">
<div class="col-12 col-md-3"><label class="form-label" for="{{.Prefix}}-key-{{.Index}}">Key</label><input class="form-control" id="{{.Prefix}}-key-{{.Index}}" name="{{.Prefix}}_key" value="{{.Row.Key}}"{{if .Row.Key}} readonly{{end}}></div>
<div class="col-6 col-md-2"><label class="form-label" for="{{.Prefix}}-operation-{{.Index}}">Operation</label><select class="form-select" id="{{.Prefix}}-operation-{{.Index}}" name="{{.Prefix}}_operation"><option value="keep"{{if eq .Row.Operation "keep"}} selected{{end}}>Keep</option><option value="set"{{if eq .Row.Operation "set"}} selected{{end}}>Replace</option><option value="remove">Remove</option></select></div>
<div class="col-6 col-md-3"><label class="form-label" for="{{.Prefix}}-kind-{{.Index}}">Value source</label><select class="form-select" id="{{.Prefix}}-kind-{{.Index}}" name="{{.Prefix}}_kind"><option value="literal"{{if eq .Row.Kind "literal"}} selected{{end}}>Literal</option><option value="protected"{{if eq .Row.Kind "protected"}} selected{{end}}>Protected</option><option value="environment"{{if eq .Row.Kind "environment"}} selected{{end}}>Deployment variable</option></select></div>
<div class="col-12 col-md-4"><label class="form-label" for="{{.Prefix}}-value-{{.Index}}">Replacement value or variable name</label><input class="form-control" id="{{.Prefix}}-value-{{.Index}}" name="{{.Prefix}}_value" type="password" autocomplete="new-password" data-mcp-secret></div>
</div>{{end}}

{{define "mcp-authorization"}}
{{with .MCP.Editor}}<section class="card mb-4" hx-boost="false" hx-history="false"><header class="card-header"><h2 class="card-title">Authorize worker</h2></header><div class="card-body">
<p>Authorize this installation's worker identity. Configuration definitions remain read-only; starting authorization captures the current trusted host configuration. Existing sessions retain their selected revision.</p>
{{if .Attempt}}
<div class="alert alert-info"><p>An authorization attempt is pending until {{.Attempt.Expires}}.</p>{{if .Attempt.Device}}<a href="{{path .Attempt.StatusPath}}" hx-boost="false">View authorization status</a>{{end}}<form action="{{path .Attempt.CancelPath}}" method="post" hx-boost="false"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-outline-secondary mt-2" type="submit">Cancel authorization</button></form></div>
{{else}}
<form action="{{path .Action}}/oauth/browser" method="post" hx-boost="false" autocomplete="off">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="mcp-client-id">Client ID</label><input class="form-control" id="mcp-client-id" name="client_id" maxlength="1024"><p class="form-text">Use a pre-registered client. Leave blank for supported browser client registration. Device authorization requires a pre-registered client.</p></div><div class="col-md-6"><label class="form-label" for="mcp-client-auth-method">Client authentication</label><select class="form-select" id="mcp-client-auth-method" name="client_auth_method"><option value="none">Public client · no secret</option><option value="client_secret_basic">Client secret · HTTP Basic</option><option value="client_secret_post">Client secret · token request</option></select></div><div class="col-12"><label class="form-label" for="mcp-client-secret">Client secret</label><input class="form-control" id="mcp-client-secret" name="client_secret" type="password" autocomplete="new-password" maxlength="16384" data-mcp-secret><p class="form-text">Write-only; never prefilled. Enter again when starting a new attempt.</p></div></div>
<div class="action-row mt-3"><button class="btn btn-primary" type="submit">Authorize in browser</button><button class="btn btn-outline-secondary" type="submit" formaction="{{path .Action}}/oauth/device">Authorize with device</button></div><p class="form-text">Device authorization must be supported by the server. If unavailable, use browser authorization.</p>
</form>
{{end}}
{{if and (eq .Row.Authorization "Authorized") .Row.RevisionID}}
<form class="mt-4" action="{{path .Action}}/oauth/retry" method="post" hx-boost="false"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_revision_id" value="{{.Row.RevisionID}}"><p class="form-text">Retry tool attachment using the saved worker grant without repeating OAuth.</p><button class="btn btn-outline-primary" type="submit">Retry tool attachment</button></form>
{{end}}
{{if .Row.Authorization}}
<form class="mt-4" action="{{path .Action}}/oauth/disconnect" method="post" hx-boost="false"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><div class="form-check mb-2"><input class="form-check-input" id="mcp-disconnect-confirm" type="checkbox" name="confirm" value="yes" required><label class="form-check-label" for="mcp-disconnect-confirm">Confirm disconnecting worker authorization, including retained sessions.</label></div><button class="btn btn-outline-danger" type="submit">Disconnect worker</button></form>
{{end}}
</div></section>{{end}}{{end}}

{{define "mcp-device"}}{{with .MCP.Device}}
<section class="card" hx-boost="false" hx-history="false"><header class="card-header"><h2 class="card-title">{{if .Instructions}}Verify worker identity{{else}}Authorization status{{end}}</h2></header><div class="card-body"><p role="status">{{.Message}}</p><dl class="fact-list"><dt>Authorization</dt><dd>{{.Status}}</dd><dt>Expires</dt><dd>{{.Expires}}</dd></dl>
{{if .Instructions}}<div data-mcp-transient><p>Open the verification page and enter this code:</p><p class="h4 text-break"><code>{{.UserCode}}</code></p><a class="btn btn-primary" href="{{if .VerificationURIComplete}}{{.VerificationURIComplete}}{{else}}{{.VerificationURI}}{{end}}" rel="noreferrer" target="_blank" hx-boost="false">Open verification page</a><p class="form-text mt-2">These instructions are shown once. After verifying, check the status below.</p></div>{{end}}
<div class="action-row mt-3"><a class="btn btn-outline-primary" href="{{path .StatusPath}}" hx-boost="false">Refresh authorization status</a><a class="btn btn-outline-secondary" href="{{path .DetailPath}}" hx-boost="false">Open connection</a></div>
{{if .Pending}}<form class="mt-3" action="{{path .CancelPath}}" method="post" hx-boost="false"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-outline-warning" type="submit">Cancel authorization</button></form>{{end}}
</div></section>{{end}}{{end}}
