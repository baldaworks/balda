{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false" data-skills><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Operations</p><h1>{{with .Skills}}{{if .Install}}Install skill{{else if .Review}}{{if .Update}}Review skill update{{else}}Review skill installation{{end}}{{else if .Detail}}Skill details{{else}}Skills{{end}}{{else}}Skills{{end}}</h1><p>Inspect skills from plugins and standalone sources. Changes apply to new or reset sessions; existing sessions retain their selected revisions.</p></div><a class="btn btn-outline-secondary" href="{{path "/skills"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">All skills</a></header>
{{with .Error}}<div class="alert alert-danger" role="alert" aria-live="polite"><h2 class="h5">{{.Heading}}</h2><p class="mb-0">{{.Message}}</p></div>{{end}}
{{if .Error}}<p><a href="{{.RestartURL}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{{.RestartLabel}}</a></p>{{end}}
{{with .Skills}}{{range .Diagnostics}}<p class="alert alert-warning" role="status">{{.}}</p>{{end}}
{{if .Pending}}<section class="card mb-4"><div class="card-body"><h2 class="h5">Recovery pending</h2><p>The accepted selection is saved. Current and desired revisions may differ until publication completes. Do not repeat installation or update.</p><form action="{{path "/skills/retry-publication"}}" method="post" hx-post="{{path "/skills/retry-publication"}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-primary" type="submit">Recover publication</button></form></div></section>{{end}}
{{if .Unavailable}}<p class="alert alert-secondary" role="status">Skills management is unavailable. Reopen this page to check its current state.</p>
{{else if .Install}}{{template "skill-install" $}}
{{else if .Review}}{{template "skill-review" $}}
{{else if .Detail}}{{template "skill-detail" $}}
{{else}}
<div class="action-row mb-4">{{if and (not .Pending) (not .MutationBlocked)}}<a class="btn btn-primary" href="{{path "/skills/install"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Install skill</a><form action="{{path "/skills/refresh"}}" method="post" hx-post="{{path "/skills/refresh"}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.ExpectedState}}"><button class="btn btn-outline-secondary" type="submit">Refresh sources</button></form>{{end}}</div>
<p>Listing does not read source files. Refresh sources explicitly to adopt changes in existing standalone skill roots.</p>
<section class="card"><header class="card-header"><h2 class="card-title">Skill inventory</h2><span class="count-badge">{{len .Rows}}</span></header><div class="table-responsive" tabindex="0" role="region" aria-label="Skills table, horizontally scrollable"><table class="table table-hover skills-table"><thead><tr><th scope="col">Name</th><th scope="col">Source</th><th scope="col">State</th><th scope="col">Actions</th></tr></thead><tbody>{{range .Rows}}<tr><td class="text-break">{{.Name}}<small class="d-block text-muted">{{.ID.String}}</small></td><td class="text-break">{{.SourceLabel}}<small class="d-block text-muted">{{.Ownership}}</small>{{if .PluginPath}}<a href="{{path .PluginPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Owning plugin</a>{{end}}</td><td>{{if .Pending}}Recovery pending{{else if .Enabled}}Enabled{{else}}Disabled{{end}}</td><td><a href="{{path .DetailPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Inspect<span class="visually-hidden"> {{.Name}} from {{.ID.Source.String}}</span></a></td></tr>{{else}}<tr><td colspan="4"><span class="empty-table-message">No skills are available.</span></td></tr>{{end}}</tbody></table></div></section>
{{end}}{{end}}</div></main>{{end}}

{{define "skill-install"}}<section class="card"><header class="card-header"><h2 class="card-title">Standalone source</h2></header><div class="card-body"><p>Choose one complete skill directory from a local source or Git repository. Resources are retained with the instructions. Installation does not execute scripts.</p><form action="{{path "/skills/review"}}" method="post" autocomplete="off" hx-post="{{path "/skills/review"}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><input type="hidden" name="expected_state" value="{{.Skills.ExpectedState}}">
<div class="mb-3"><label class="form-label" for="skill-source">Source</label><input class="form-control" id="skill-source" name="source" data-private-source maxlength="4096" placeholder="https://example.test/team/skills.git or a local directory" required><p class="form-text">Available to the Balda host. Source is cleared after submission and is not shown in the review.</p></div>
<div class="mb-3"><label class="form-label" for="skill-ref">Ref — optional</label><input class="form-control" id="skill-ref" name="ref" maxlength="256" placeholder="main"><p class="form-text">Git branch, tag or commit. Leave empty for the default branch; local sources do not use Ref.</p></div>
<div class="mb-4"><label class="form-label" for="skill-path">Skill path</label><input class="form-control" id="skill-path" name="path" maxlength="4096" placeholder="." value="."><p class="form-text">Relative directory containing SKILL.md. Use . when the source root is the skill.</p></div><div class="action-row">{{if not .Skills.MutationBlocked}}{{if not .Skills.Pending}}<button class="btn btn-primary" type="submit">Review installation</button>{{end}}{{end}}<a class="btn btn-outline-secondary" href="{{path "/skills"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Cancel</a></div></form></div></section>{{end}}

{{define "skill-review"}}{{with .Skills.Review}}<section class="card"><header class="card-header"><h2 class="card-title">{{.Entry.Name}}</h2></header><div class="card-body"><p class="text-break">{{.Entry.Description}}</p><dl class="detail-grid"><dt>Source</dt><dd class="text-break">{{.Entry.SourceLabel}}</dd><dt>Skill path</dt><dd class="text-break">{{.SkillPath}}</dd><dt>Content revision</dt><dd class="text-break"><code>{{.Entry.Revision}}</code></dd><dt>Resolved Git commit</dt><dd class="text-break">{{if .ResolvedCommit}}<code>{{.ResolvedCommit}}</code>{{else}}Local source{{end}}</dd><dt>After acceptance</dt><dd>{{if .Entry.Enabled}}Enabled{{else}}Disabled{{end}}</dd><dt>Review expires</dt><dd>{{.ExpiresAt.Format "2006-01-02 15:04:05 UTC"}}</dd></dl><p>The complete skill and its supporting resources will be retained. Acceptance checks that the reviewed source is unchanged.</p><form action="{{path "/skills/accept"}}" method="post" hx-post="{{path "/skills/accept"}}" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="candidate_handle" value="{{.Handle}}">{{if $.Skills.Update}}<input type="hidden" name="skill_id" value="{{.Entry.ID.Source.Name}}">{{end}}<div class="action-row">{{if not $.Skills.MutationBlocked}}{{if not $.Skills.Pending}}<button class="btn btn-primary" type="submit">{{if $.Skills.Update}}Accept update{{else}}Install reviewed skill{{end}}</button>{{end}}{{end}}<a class="btn btn-outline-secondary" href="{{$.RestartURL}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Cancel</a></div></form></div></section>{{end}}{{end}}

{{define "skill-detail"}}{{with .Skills.Detail}}<section class="card mb-4"><header class="card-header"><h2 class="card-title text-break">{{.Name}}</h2></header><div class="card-body"><p class="text-break">{{.Description}}</p><dl class="detail-grid"><dt>Source</dt><dd class="text-break">{{.SourceLabel}}</dd><dt>Contribution ID</dt><dd class="text-break"><code>{{.ID.String}}</code></dd><dt>Ownership</dt><dd>{{.Ownership}}</dd><dt>State</dt><dd>{{if .Pending}}Recovery pending{{else if .Enabled}}Enabled{{else}}Disabled{{end}}</dd><dt>Current revision</dt><dd class="text-break"><code>{{if .CurrentRevision}}{{.CurrentRevision}}{{else}}Not selected{{end}}</code></dd><dt>Desired revision</dt><dd class="text-break"><code>{{.Revision}}</code></dd></dl>{{if .PluginPath}}<p>Managed by the owning plugin.</p><a href="{{path .PluginPath}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Open owning plugin</a>{{else if ne .Ownership "managed"}}<p>This existing standalone source is read-only here. Edit its files outside Balda, then use Refresh sources.</p>{{end}}</div></section>
{{if eq .Ownership "managed"}}{{if not $.Skills.Pending}}{{if not $.Skills.MutationBlocked}}<section class="card mb-4"><header class="card-header"><h2 class="card-title">Update and enablement</h2></header><div class="card-body"><p>Update reviews the recorded origin. Enable and disable use the retained revision without fetching the source.</p><form class="mb-4" action="{{path .DetailPath}}/review-update" method="post" hx-post="{{path .DetailPath}}/review-update" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{$.Skills.ExpectedState}}"><button class="btn btn-primary" type="submit">Review update</button></form>
{{if .Enabled}}<form action="{{path .DetailPath}}/disable" method="post" hx-post="{{path .DetailPath}}/disable" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{$.Skills.ExpectedState}}"><div class="form-check mb-3"><input class="form-check-input" id="skill-disable-confirm" type="checkbox" name="confirm" value="yes" required><label class="form-check-label" for="skill-disable-confirm">Confirm disabling this skill for new sessions.</label></div><button class="btn btn-outline-warning" type="submit">Disable skill</button></form>{{else}}<form action="{{path .DetailPath}}/enable" method="post" hx-post="{{path .DetailPath}}/enable" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{$.Skills.ExpectedState}}"><button class="btn btn-primary" type="submit">Enable skill</button></form>{{end}}</div></section>
<section class="card"><header class="card-header"><h2 class="card-title">Remove skill</h2></header><div class="card-body"><p>Removes this managed installation from new sessions. Existing session pins and archived resources are retained. Source files remain untouched.</p><form action="{{path .DetailPath}}/remove" method="post" hx-post="{{path .DetailPath}}/remove" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="expected_state" value="{{$.Skills.ExpectedState}}"><div class="form-check mb-3"><input class="form-check-input" id="skill-remove-confirm" type="checkbox" name="confirm" value="yes" required><label class="form-check-label" for="skill-remove-confirm">Confirm removing this managed skill.</label></div><div class="action-row"><button class="btn btn-outline-danger" type="submit">Remove skill</button><a class="btn btn-outline-secondary" href="{{path "/skills"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Cancel</a></div></form></div></section>{{end}}{{end}}{{end}}{{end}}{{end}}
