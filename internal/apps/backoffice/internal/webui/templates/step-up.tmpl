{{define "content"}}<main id="main-content" class="login-page" tabindex="-1" hx-history="false"><section class="login-box"><div class="card"><header class="card-header"><h1 class="h3">Confirm your passkey</h1></header><div class="card-body"><p>Your last verification has expired for sensitive actions. After confirming, return and submit your change again.</p><form method="post" action="{{path "/auth/step-up/start"}}" hx-boost="false" hx-history="false"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><input type="hidden" name="return_to" value="{{.ReturnTo}}"><button type="submit" class="btn btn-primary">Confirm passkey</button> <a href="{{path "/account"}}" class="btn btn-outline-secondary" hx-boost="false">Cancel</a></form></div></div></section></main>{{end}}
