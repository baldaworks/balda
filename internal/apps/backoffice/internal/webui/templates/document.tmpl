{{define "document"}}<!doctype html>
<html lang="en" data-bs-theme="dark" data-lte-color-mode="off">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <link rel="stylesheet" href="{{assetPath "/"}}assets/vendor/adminlte/adminlte.min.css">
  <link rel="stylesheet" href="{{assetPath "/"}}assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{assetPath "/assets/app.css"}}">
</head>
<body class="layout-fixed fixed-header sidebar-expand-lg bg-body-tertiary" data-refresh-path="{{path "/"}}auth/session/refresh">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="app-wrapper{{if not .Navigation}} auth-wrapper{{end}}">
  {{if .Navigation}}
  <header class="app-header navbar navbar-expand" aria-label="Utility navigation">
    <div class="container-fluid">
      <button class="nav-link btn btn-link sidebar-toggle enhanced-only" type="button" data-lte-toggle="sidebar" aria-label="Toggle navigation" aria-controls="primary-sidebar" aria-expanded="true"><i class="bi bi-list" aria-hidden="true"></i></button>
      <details class="native-navigation d-lg-none"><summary class="btn btn-outline-secondary">Menu</summary><nav aria-label="Mobile navigation">
        {{range .Navigation}}<a class="nav-link{{if .Current}} active{{end}}" data-nav-link href="{{path .Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}
      </nav></details>
      <div class="viewer-actions ms-auto"><span class="viewer"><i class="bi bi-person-circle" aria-hidden="true"></i> <span class="viewer-prefix">Signed in as </span><strong title="{{.ViewerUsername}}">{{.ViewerUsername}}</strong></span>
        <a class="btn btn-sm btn-outline-secondary" href="{{path "/"}}account" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" aria-label="Your account"><i class="bi bi-person" aria-hidden="true"></i><span class="d-none d-sm-inline"> Account</span></a>
        <form method="post" action="{{path "/"}}logout" hx-boost="false" class="m-0"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="btn btn-sm btn-outline-secondary" type="submit"{{if .Preview}} disabled title="Synthetic preview"{{end}}><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="d-none d-sm-inline"> Sign out</span><span class="visually-hidden d-sm-none">Sign out</span></button></form>
      </div>
    </div>
  </header>
  <aside id="primary-sidebar" class="app-sidebar shadow" data-bs-theme="dark">
    <div class="sidebar-brand"><a href="{{path "/"}}overview" class="brand-link"><span class="brand-mark" aria-hidden="true">B</span><span class="brand-text">Balda</span></a></div>
    <div class="sidebar-wrapper"><nav aria-label="Primary navigation"><ul class="nav sidebar-menu flex-column" role="list">
      {{range .Navigation}}<li class="nav-item"><a class="nav-link{{if .Current}} active{{end}}" data-nav-link href="{{path .Href}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true"{{if .Current}} aria-current="page"{{end}}><i class="nav-icon bi {{.Icon}}" aria-hidden="true"></i><p>{{.Label}}</p></a></li>{{end}}
    </ul></nav></div>
  </aside>
  {{end}}
  <div class="app-main" hx-history-elt><div id="request-error" class="alert alert-danger m-3" role="alert" tabindex="-1" hidden></div>{{template "content" .}}</div>
  {{if .Navigation}}<footer class="app-footer"><span>Balda Backoffice</span><span class="d-none d-sm-inline">Internal operations</span></footer>{{end}}
</div>
<script src="{{assetPath "/"}}assets/vendor/htmx/htmx.min.js"></script>
<script src="{{assetPath "/"}}assets/vendor/adminlte/adminlte.min.js"></script>
<script src="{{assetPath "/assets/app.js"}}"></script>
</body>
</html>{{end}}
