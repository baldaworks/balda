{{define "content"}}<main id="main-content" class="app-content" tabindex="-1" hx-history="false" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true"><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Workspace</p><h1>{{if .ChatArchive.Detail}}Session chat{{else}}Chat sessions{{end}}</h1><p class="text-body-secondary">Browse current sessions and archived user/agent chats.</p></div></header>
{{with .ChatArchive}}
{{if .Detail}}
<nav class="mb-3 d-flex flex-wrap gap-3" aria-label="Chat session navigation"><a href="{{path .BackPath}}">Back to Chat sessions</a>{{if .PreviousPath}}<a href="{{path .PreviousPath}}">Previous session</a>{{end}}{{if .NextPath}}<a href="{{path .NextPath}}">Next session</a>{{end}}</nav>
{{with .Detail}}
<section class="card mb-4"><div class="card-body archive-metadata"><h2 class="h4">{{.Label}}</h2><div class="d-flex flex-wrap gap-2 mb-3"><span class="badge text-bg-secondary">{{.Channel}}</span><span class="badge text-bg-secondary">{{.Audience}}</span><span class="badge text-bg-secondary">{{.Subdivision}}</span><span class="badge text-bg-secondary">{{.Status}}</span></div>
<dl class="row mb-0"><dt class="col-sm-3">Location</dt><dd class="col-sm-9">{{.Title}}{{if .SubdivisionLabel}} · {{.SubdivisionLabel}}{{end}}</dd><dt class="col-sm-3">Locator</dt><dd class="col-sm-9">{{.Locator}}</dd><dt class="col-sm-3">People</dt><dd class="col-sm-9">{{.Person}}</dd><dt class="col-sm-3">Started</dt><dd class="col-sm-9">{{.Started}}</dd><dt class="col-sm-3">Latest activity</dt><dd class="col-sm-9">{{.Activity}}</dd><dt class="col-sm-3">Messages</dt><dd class="col-sm-9">{{.MessageCount}}</dd>{{if .EndReason}}<dt class="col-sm-3">End reason</dt><dd class="col-sm-9">{{.EndReason}} · {{.Ended}}</dd>{{end}}</dl>
{{if .Partial}}<p class="alert alert-warning mt-3 mb-0">Partial coverage: chat capture starts {{.CoverageStart}}. Earlier messages were not backfilled.</p>{{end}}
{{if eq .Status "Activation pending"}}<p class="alert alert-warning mt-3 mb-0">Session activation is pending. This session is not confirmed active.</p>{{end}}{{if eq .Status "Status uncertain"}}<p class="alert alert-warning mt-3 mb-0">Session status is uncertain. Retained chat does not confirm current activity.</p>{{end}}
</div></section>
{{end}}
<section aria-label="Session transcript" class="archive-transcript"><h2 class="h4">Chat</h2>{{if .OlderPath}}<a class="btn btn-outline-secondary mb-3" href="{{path .OlderPath}}">Older messages</a>{{end}}
{{range .Messages}}<article class="card archive-message archive-message-{{.Role}} mb-3"><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><div><strong>{{.Speaker}}</strong> <span class="badge text-bg-secondary">{{.Role}}</span>{{if .Principal}}<div class="text-body-secondary small">{{.Principal}}{{if .Username}} · @{{.Username}}{{end}}</div>{{end}}</div><time class="small text-body-secondary">{{.At}}</time></div><div class="archive-text">{{.Text}}</div>{{if .Attachments}}<ul class="list-unstyled mt-2 mb-0">{{range .Attachments}}<li class="archive-attachment"><i class="bi bi-paperclip" aria-hidden="true"></i> {{.Name}}{{if .Kind}} <span class="text-body-secondary">({{.Kind}})</span>{{end}}</li>{{end}}</ul>{{end}}</div></article>{{else}}<div class="card"><div class="card-body"><h3 class="h5">No chat messages</h3><p class="mb-0 text-body-secondary">No user or agent chat has been captured for this session.</p></div></div>{{end}}
</section>
{{else}}
<form method="get" action="{{path "/chat-sessions"}}" class="card mb-4"><div class="card-body"><div class="row g-3 align-items-end"><div class="col-xl-5"><label for="archive-query" class="form-label">Search session metadata</label><input id="archive-query" class="form-control" name="q" value="{{.Query}}" maxlength="200" placeholder="Label, location or locator" aria-describedby="archive-search-hint"><div id="archive-search-hint" class="form-text">Literal, case-sensitive metadata search. Chat text is not searched.</div></div><div class="col-sm-4 col-xl-3"><label for="archive-channel" class="form-label">Channel</label><select id="archive-channel" class="form-select" name="channel"><option value="">All channels</option><option value="telegram" {{if eq .Channel "telegram"}}selected{{end}}>Telegram</option><option value="slackagent" {{if eq .Channel "slackagent"}}selected{{end}}>Slack</option><option value="zulip" {{if eq .Channel "zulip"}}selected{{end}}>Zulip</option><option value="mattermost" {{if eq .Channel "mattermost"}}selected{{end}}>Mattermost</option></select></div><div class="col-sm-4 col-xl-2"><label for="archive-status" class="form-label">Status</label><select id="archive-status" class="form-select" name="status"><option value="">All statuses</option><option value="active" {{if eq .Status "active"}}selected{{end}}>Active</option><option value="ended" {{if eq .Status "ended"}}selected{{end}}>Archived</option><option value="pending" {{if eq .Status "pending"}}selected{{end}}>Pending</option><option value="uncertain" {{if eq .Status "uncertain"}}selected{{end}}>Uncertain</option></select></div><div class="col-sm-4 col-xl-2 d-flex gap-2"><button class="btn btn-primary" type="submit">Filter</button><a class="btn btn-outline-secondary" href="{{path "/chat-sessions"}}">Clear</a></div></div></div></form>
{{if .Rows}}<div class="card"><div class="table-responsive"><table class="table align-middle mb-0 archive-table"><thead><tr><th scope="col">Session / location</th><th scope="col">Channel / people</th><th scope="col">Status</th><th scope="col">Messages</th><th scope="col">Latest activity</th></tr></thead><tbody>{{range .Rows}}<tr><td><a href="{{path .DetailPath}}">{{.Label}}</a><div class="text-body-secondary small">{{.Title}}{{if .SubdivisionLabel}} · {{.SubdivisionLabel}}{{end}}</div><div class="small">{{.Locator}}</div></td><td>{{.Channel}}<div class="small">{{.Audience}} · {{.Subdivision}}</div><div class="text-body-secondary small">{{.Person}}</div></td><td>{{.Status}}{{if .EndReason}}<div class="small text-body-secondary">{{.EndReason}}</div>{{end}}{{if .Partial}}<div class="small text-warning">Partial coverage</div>{{end}}</td><td>{{.MessageCount}}</td><td>{{.Activity}}</td></tr>{{end}}</tbody></table></div></div>{{else}}<div class="card"><div class="card-body"><h2 class="h5">No chat sessions</h2><p class="mb-0 text-body-secondary">No captured sessions match these filters. Chat capture starts with this upgrade; earlier messages are not backfilled.</p></div></div>{{end}}
{{if .OlderPath}}<a class="btn btn-outline-secondary mt-3" href="{{path .OlderPath}}">Older sessions</a>{{end}}
{{end}}
{{end}}
</div></main>{{end}}
