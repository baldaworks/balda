{{define "content"}}<main hx-history="false" id="main-content" class="login-page" data-bs-theme="dark" tabindex="-1">
  <section class="login-box" aria-labelledby="login-heading">
    <div class="card">
      <div class="card-header text-center"><h1 id="login-heading" class="h3 mb-0">Sign in</h1></div>
      <div class="card-body"><p>Use your Backoffice username and password.</p>
        {{with .Error}}<div id="login-error" class="alert alert-danger" role="alert"><strong>{{.Heading}}</strong> {{.Message}}</div>{{end}}
        <form method="post" action="{{path "/"}}login" hx-boost="false"{{if .Error}} aria-describedby="login-error"{{end}}>
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <div class="mb-3"><label for="username" class="form-label">Username</label><input id="username" name="username" value="{{.LoginUsername}}" class="form-control" autocomplete="username" required autofocus{{if .Error}} aria-invalid="true" aria-describedby="login-error"{{end}}></div>
          <div class="mb-3"><label for="password" class="form-label">Password</label><input id="password" name="password" type="password" data-write-only class="form-control" autocomplete="current-password" required{{if .Error}} aria-invalid="true" aria-describedby="login-error"{{end}}></div>
          <button class="btn btn-primary w-100" type="submit">Sign in</button>
        </form>
        <p class="small mb-0 mt-3">Lost your password? Ask an administrator to reset it.</p>
      </div>
    </div>
  </section>
</main>{{end}}
