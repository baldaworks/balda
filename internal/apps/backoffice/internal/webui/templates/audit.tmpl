{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid py-3"><h1>Audit</h1>
    <form action="/audit" method="get" hx-get="/audit" hx-target="#main-content" hx-push-url="true" class="card card-body mb-3"><div class="row g-3">
      <div class="col-lg-5"><label class="form-label" for="audit-action">Action</label><select class="form-select" id="audit-action" name="action"><option value="">All security actions</option><option value="user.created"{{if eq .AuditAction "user.created"}} selected{{end}}>user.created</option><option value="user.updated"{{if eq .AuditAction "user.updated"}} selected{{end}}>user.updated</option><option value="user.access.changed"{{if eq .AuditAction "user.access.changed"}} selected{{end}}>user.access.changed</option><option value="user.role.changed"{{if eq .AuditAction "user.role.changed"}} selected{{end}}>user.role.changed</option><option value="user.status.changed"{{if eq .AuditAction "user.status.changed"}} selected{{end}}>user.status.changed</option><option value="user.credential.changed"{{if eq .AuditAction "user.credential.changed"}} selected{{end}}>user.credential.changed</option><option value="session.login.succeeded"{{if eq .AuditAction "session.login.succeeded"}} selected{{end}}>session.login.succeeded</option><option value="session.refresh.succeeded"{{if eq .AuditAction "session.refresh.succeeded"}} selected{{end}}>session.refresh.succeeded</option><option value="session.refresh.replay"{{if eq .AuditAction "session.refresh.replay"}} selected{{end}}>session.refresh.replay</option><option value="session.revoked"{{if eq .AuditAction "session.revoked"}} selected{{end}}>session.revoked</option><option value="session.logout"{{if eq .AuditAction "session.logout"}} selected{{end}}>session.logout</option><option value="user.binding.claim.created"{{if eq .AuditAction "user.binding.claim.created"}} selected{{end}}>user.binding.claim.created</option><option value="user.binding.attached"{{if eq .AuditAction "user.binding.attached"}} selected{{end}}>user.binding.attached</option><option value="user.migrated"{{if eq .AuditAction "user.migrated"}} selected{{end}}>user.migrated</option></select></div>
      <div class="col-lg-3"><label class="form-label" for="audit-outcome">Outcome</label><select class="form-select" id="audit-outcome" name="outcome"><option value="">All outcomes</option><option value="succeeded"{{if eq .AuditOutcome "succeeded"}} selected{{end}}>Succeeded</option><option value="denied"{{if eq .AuditOutcome "denied"}} selected{{end}}>Denied</option></select></div>
      <div class="col-lg-3"><label class="form-label" for="audit-target">Target</label><select class="form-select" id="audit-target" name="target"><option value="">All targets</option><option value="user"{{if eq .AuditTargetType "user"}} selected{{end}}>User</option><option value="session"{{if eq .AuditTargetType "session"}} selected{{end}}>Session family</option><option value="binding"{{if eq .AuditTargetType "binding"}} selected{{end}}>Binding</option><option value="system"{{if eq .AuditTargetType "system"}} selected{{end}}>System</option><option value="migration"{{if eq .AuditTargetType "migration"}} selected{{end}}>Migration</option></select></div><div class="col-lg-1 d-flex align-items-end"><button class="btn btn-primary" type="submit">Filter</button></div>
    </div></form>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Time</th><th scope="col">Action</th><th scope="col">Outcome</th><th scope="col">Actor</th><th scope="col">Target</th><th scope="col">Event</th></tr></thead><tbody>{{range .Audit}}<tr><td>{{.OccurredAt}}</td><td><code>{{.Action}}</code></td><td>{{.Outcome}}</td><td>{{if .ActorUserID}}user:{{.ActorUserID}}{{end}}{{if .ActorSessionID}}<br>session:{{.ActorSessionID}}{{end}}{{if and (not .ActorUserID) (not .ActorSessionID)}}System{{end}}</td><td>{{.TargetType}}:<code>{{.TargetID}}</code></td><td><code>{{.ID}}</code></td></tr>{{else}}<tr><td colspan="6">No audit events.</td></tr>{{end}}</tbody></table></div>{{if .NextURL}}<a class="btn btn-outline-primary" href="{{.NextURL}}" hx-boost="true" hx-target="#main-content" hx-push-url="true">Next page</a>{{end}}
  </div>
</main>{{end}}
