{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid"><header class="content-header"><div><p class="section-kicker">Administration</p><h1>Audit</h1><p>Recent security events appear first. Times are shown in UTC.</p></div></header>
    {{with .Error}}<div id="audit-filter-error" class="alert alert-danger" role="alert" aria-live="polite"><h2 class="h5">{{.Heading}}</h2><p class="mb-0">{{.Message}}</p></div>{{end}}
    <form action="{{path "/"}}audit" method="get" hx-get="{{path "/"}}audit" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="card mb-3 audit-filters"{{if .Error}} aria-describedby="audit-filter-error"{{end}}><div class="card-body"><div class="row g-2 align-items-end">
      <div class="col-12 col-md-6"><label class="form-label" for="audit-action">Action</label><select class="form-select" id="audit-action" name="action"><option value="">All security actions</option>{{range .AuditActions}}<option value="{{.Value}}"{{if eq $.AuditAction .Value}} selected{{end}}>{{.Label}}</option>{{end}}</select></div>
      <div class="col-6 col-md-3"><label class="form-label" for="audit-outcome">Outcome</label><select class="form-select" id="audit-outcome" name="outcome"><option value="">All</option><option value="succeeded"{{if eq .AuditOutcome "succeeded"}} selected{{end}}>Succeeded</option><option value="denied"{{if eq .AuditOutcome "denied"}} selected{{end}}>Denied</option></select></div>
      <div class="col-6 col-md-3"><label class="form-label" for="audit-target">Target</label><select class="form-select" id="audit-target" name="target"><option value="">All</option>{{range .AuditTargets}}<option value="{{.Value}}"{{if eq $.AuditTargetType .Value}} selected{{end}}>{{.Label}}</option>{{end}}</select></div>
      <div class="col-12"><details{{if or .AuditFrom .AuditTo .AuditActor}} open{{end}}><summary>Dates and actor ID</summary><div class="row g-2 align-items-end mt-1">
        <div class="col-6 col-md-3"><label class="form-label" for="audit-from">From</label><input class="form-control" id="audit-from" name="from" type="date" value="{{.AuditFrom}}"></div>
        <div class="col-6 col-md-3"><label class="form-label" for="audit-to">Through</label><input class="form-control" id="audit-to" name="to" type="date" value="{{.AuditTo}}"></div>
        <div class="col-12 col-md-6"><label class="form-label" for="audit-actor">Actor user ID</label><input class="form-control" id="audit-actor" name="actor" value="{{.AuditActor}}" maxlength="128" autocomplete="off"></div>
      </div></details></div>
      <div class="col-12 d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Filter events</button>{{if or .AuditAction .AuditOutcome .AuditTargetType .AuditFrom .AuditTo .AuditActor}}<a class="btn btn-outline-secondary" href="{{path "/"}}audit" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Clear filters</a>{{end}}</div>
    </div></div></form>
    <section aria-label="Security events" class="card"><header class="card-header"><h2 class="card-title">Security events</h2><span class="support-meta">Newest first · UTC</span></header>{{template "table-scroll-hint" "security-events-table-scroll-hint"}}<div class="table-responsive" role="region" aria-label="Security events table" data-table-scroll-region data-table-scroll-hint="security-events-table-scroll-hint">
      <table class="table table-hover audit-table"><thead><tr><th scope="col">Time (UTC)</th><th scope="col">Action</th><th scope="col">Actor</th><th scope="col">Target</th><th scope="col">Outcome</th><th scope="col">Details</th></tr></thead><tbody>
      {{range .Audit}}<tr>
        <td><time datetime="{{.OccurredAt.Format "2006-01-02T15:04:05Z07:00"}}">{{.OccurredAt.Format "02 Jan 2006"}}<br>{{.OccurredAt.Format "15:04:05"}}</time></td>
        <td>{{.ActionLabel}}</td><td class="event-actor">{{.ActorName}}</td><td class="event-target">{{.TargetName}}</td>
        <td><span class="status-chip {{if eq .Outcome "denied"}}status-chip--warning{{else}}status-chip--success{{end}}">{{.Outcome}}</span></td>
        <td><details><summary>Technical details</summary><dl class="mt-2 mb-0">
          <dt>Action code</dt><dd><code>{{.Action}}</code></dd>
          <dt>Actor user ID</dt><dd><code>{{if .ActorUserID}}{{.ActorUserID}}{{else}}—{{end}}</code></dd>
          <dt>Actor session ID</dt><dd><code>{{if .ActorSessionID}}{{.ActorSessionID}}{{else}}—{{end}}</code></dd>
          <dt>Target</dt><dd><code>{{.TargetType}}:{{.TargetID}}</code></dd>
          <dt>Event ID</dt><dd><code>{{.ID}}</code></dd>
        </dl></details></td>
      </tr>{{else}}<tr><td colspan="6"><span class="empty-table-message">No audit events match these filters. Adjust the filters or review an older page.</span></td></tr>{{end}}
      </tbody></table>
    </div></section>
    {{if .NextURL}}<a class="btn btn-outline-primary mt-3" href="{{.NextURL}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Older events</a>{{end}}
  </div>
</main>{{end}}
