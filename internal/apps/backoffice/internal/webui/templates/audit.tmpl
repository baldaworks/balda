{{define "content"}}<main id="main-content" class="app-content" tabindex="-1">
  <div class="container-fluid py-3"><h1>Audit</h1>
    <p class="text-body-secondary">Recent security events appear first. Times are shown in UTC.</p>
    <form action="{{path "/"}}audit" method="get" hx-get="{{path "/"}}audit" hx-target="#main-content" hx-push-url="true" class="card mb-3"><div class="card-body"><div class="row g-2 align-items-end">
      <div class="col-12 col-lg-4"><label class="form-label" for="audit-action">Action</label><select class="form-select" id="audit-action" name="action">
        <option value="">All security actions</option>
        <option value="user.created"{{if eq .AuditAction "user.created"}} selected{{end}}>User created</option>
        <option value="user.updated"{{if eq .AuditAction "user.updated"}} selected{{end}}>User updated</option>
        <option value="user.access.changed"{{if eq .AuditAction "user.access.changed"}} selected{{end}}>User access changed</option>
        <option value="user.role.changed"{{if eq .AuditAction "user.role.changed"}} selected{{end}}>User role changed</option>
        <option value="user.status.changed"{{if eq .AuditAction "user.status.changed"}} selected{{end}}>User status changed</option>
        <option value="user.credential.changed"{{if eq .AuditAction "user.credential.changed"}} selected{{end}}>Credential changed</option>
        <option value="user.binding.claim.created"{{if eq .AuditAction "user.binding.claim.created"}} selected{{end}}>Binding invitation created</option>
        <option value="user.binding.attached"{{if eq .AuditAction "user.binding.attached"}} selected{{end}}>Chat binding added</option>
        <option value="user.binding.detached"{{if eq .AuditAction "user.binding.detached"}} selected{{end}}>Chat binding removed</option>
        <option value="user.migrated"{{if eq .AuditAction "user.migrated"}} selected{{end}}>User migrated</option>
        <option value="session.login.succeeded"{{if eq .AuditAction "session.login.succeeded"}} selected{{end}}>Signed in</option>
        <option value="session.refresh.succeeded"{{if eq .AuditAction "session.refresh.succeeded"}} selected{{end}}>Session restored</option>
        <option value="session.refresh.replay"{{if eq .AuditAction "session.refresh.replay"}} selected{{end}}>Session token replay</option>
        <option value="session.revoked"{{if eq .AuditAction "session.revoked"}} selected{{end}}>Session ended</option>
        <option value="session.logout"{{if eq .AuditAction "session.logout"}} selected{{end}}>Signed out</option>
      </select></div>
      <div class="col-6 col-lg-2"><label class="form-label" for="audit-outcome">Outcome</label><select class="form-select" id="audit-outcome" name="outcome"><option value="">All</option><option value="succeeded"{{if eq .AuditOutcome "succeeded"}} selected{{end}}>Succeeded</option><option value="denied"{{if eq .AuditOutcome "denied"}} selected{{end}}>Denied</option></select></div>
      <div class="col-6 col-lg-2"><label class="form-label" for="audit-target">Target</label><select class="form-select" id="audit-target" name="target"><option value="">All</option><option value="user"{{if eq .AuditTargetType "user"}} selected{{end}}>User</option><option value="session"{{if eq .AuditTargetType "session"}} selected{{end}}>Session</option><option value="binding"{{if eq .AuditTargetType "binding"}} selected{{end}}>Binding</option><option value="system"{{if eq .AuditTargetType "system"}} selected{{end}}>System</option><option value="migration"{{if eq .AuditTargetType "migration"}} selected{{end}}>Migration</option></select></div>
      <div class="col-6 col-lg-2"><label class="form-label" for="audit-from">From</label><input class="form-control" id="audit-from" name="from" type="date" value="{{.AuditFrom}}"></div>
      <div class="col-6 col-lg-2"><label class="form-label" for="audit-to">Through</label><input class="form-control" id="audit-to" name="to" type="date" value="{{.AuditTo}}"></div>
      <div class="col-12 col-lg-8"><label class="form-label" for="audit-actor">Actor user ID (optional)</label><input class="form-control" id="audit-actor" name="actor" value="{{.AuditActor}}" maxlength="128" autocomplete="off"></div>
      <div class="col-12 col-lg-4"><button class="btn btn-primary w-100" type="submit">Filter events</button></div>
    </div></div></form>
    <section aria-label="Security events" class="row g-3">
      {{range .Audit}}<div class="col-12 col-xl-6"><article class="card h-100"><div class="card-body">
        <p class="text-body-secondary mb-1"><time datetime="{{.OccurredAt.Format "2006-01-02T15:04:05Z07:00"}}">{{.OccurredAt.Format "02 Jan 2006, 15:04:05 UTC"}}</time></p>
        <h2 class="h5">{{.ActionLabel}} <span class="badge {{if eq .Outcome "denied"}}text-bg-warning{{else}}text-bg-success{{end}}">{{.Outcome}}</span></h2>
        <p class="mb-2"><strong>{{.ActorName}}</strong> → {{.TargetName}}</p>
        <details><summary>Technical details</summary><dl class="row mt-2 mb-0">
          <dt class="col-sm-4">Action code</dt><dd class="col-sm-8"><code>{{.Action}}</code></dd>
          <dt class="col-sm-4">Actor user ID</dt><dd class="col-sm-8"><code>{{if .ActorUserID}}{{.ActorUserID}}{{else}}—{{end}}</code></dd>
          <dt class="col-sm-4">Actor session ID</dt><dd class="col-sm-8"><code>{{if .ActorSessionID}}{{.ActorSessionID}}{{else}}—{{end}}</code></dd>
          <dt class="col-sm-4">Target</dt><dd class="col-sm-8"><code>{{.TargetType}}:{{.TargetID}}</code></dd>
          <dt class="col-sm-4">Event ID</dt><dd class="col-sm-8"><code>{{.ID}}</code></dd>
        </dl></details>
      </div></article></div>{{else}}<div class="col-12"><p>No audit events match these filters. Adjust the filters or review an older page.</p></div>{{end}}
    </section>
    {{if .NextURL}}<a class="btn btn-outline-primary mt-3" href="{{.NextURL}}" hx-boost="true" hx-target="#main-content" hx-push-url="true">Older events</a>{{end}}
  </div>
</main>{{end}}
