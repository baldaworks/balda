{{define "content"}}<main id="main-content" class="app-content" tabindex="-1"><div class="container-fluid">
<header class="content-header"><div><p class="section-kicker">Layout foundation</p><h1>Full layout example</h1><p>Top bar, navigation, content and footer use the same shell as every console page.</p></div><a class="btn btn-outline-primary" href="{{path "/style-guide"}}" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Component guide</a></header>
<div class="detail-grid"><section class="card"><header class="card-header"><h2 class="card-title">Operator workspace</h2><span class="status-chip status-chip--info">Synthetic</span></header><div class="card-body"><dl class="fact-list"><dt>Viewer</dt><dd>{{.ViewerUsername}}</dd><dt>Navigation</dt><dd>Collapse on desktop; open an overlay on mobile.</dd><dt>Content</dt><dd>Short content keeps the footer at the bottom. Long content scrolls with the page.</dd></dl></div></section><section class="card"><header class="card-header"><h2 class="card-title">Example form</h2></header><div class="card-body"><label for="layout-label" class="form-label">Display label</label><input id="layout-label" class="form-control" value="Synthetic workspace"><p class="form-text">This example has no application action.</p><div class="action-row"><button type="button" class="btn btn-primary" disabled>Save example</button><a href="{{path "/"}}" class="btn btn-outline-secondary">All previews</a></div></div></section></div>
{{if .Gallery}}<section class="card mt-4"><header class="card-header"><h2 class="card-title">Long content example</h2></header><div class="card-body">{{range .Gallery}}<article class="py-4 border-bottom"><h3 class="h5">{{.Label}}</h3><p class="text-body-secondary">A synthetic entry exercises long labels, wrapping and stable column widths. This content describes presentation only and does not represent live activity.</p><dl class="fact-list"><dt>Technical reference</dt><dd><code>synthetic-reference-with-a-long-identifier-for-overflow-checks-0123456789</code></dd><dt>State</dt><dd><span class="status-chip">Example</span></dd></dl></article>{{end}}</div></section>{{end}}
</div></main>{{end}}
