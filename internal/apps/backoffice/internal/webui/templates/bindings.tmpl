{{define "binding-telegram"}}<section class="card binding-panel" data-binding-channel="telegram" aria-labelledby="binding-telegram-heading"><header class="card-header"><h2 id="binding-telegram-heading" class="card-title"><i class="bi bi-telegram" aria-hidden="true"></i> Connect Telegram</h2></header><div class="card-body"><p>Open the configured bot and send its generated start command, or paste the invitation into your conversation.</p>{{with .BotUsername}}<p class="text-body-secondary">Bot: <strong>@{{.}}</strong></p>{{end}}{{template "binding-reveal" .}}{{template "binding-controls" .}}</div></section>{{end}}

{{define "binding-slack"}}<section class="card binding-panel" data-binding-channel="slackagent" aria-labelledby="binding-slackagent-heading"><header class="card-header"><h2 id="binding-slackagent-heading" class="card-title"><i class="bi bi-slack" aria-hidden="true"></i> Connect Slack Agent</h2></header><div class="card-body"><p>Open this bot's DM in its verified workspace. Send the invitation there, or run its native start command.</p>{{if .Ready}}<p class="text-body-secondary">Workspace: <strong>{{.BotName}}</strong>{{with .BotUsername}} · Bot: <strong>{{.}}</strong>{{end}}</p>{{end}}{{template "binding-reveal" .}}{{template "binding-controls" .}}</div></section>{{end}}

{{define "binding-zulip"}}<section class="card binding-panel" data-binding-channel="zulip" aria-labelledby="binding-zulip-heading"><header class="card-header"><h2 id="binding-zulip-heading" class="card-title"><i class="bi bi-chat-dots" aria-hidden="true"></i> Connect Zulip</h2></header><div class="card-body"><p>Open a direct conversation with this realm's bot. Send the invitation or its start command there.</p>{{with .BotUsername}}<p class="text-body-secondary">Bot: <strong>{{.}}</strong>{{with $.BotName}} · {{.}}{{end}}</p>{{end}}{{template "binding-reveal" .}}{{template "binding-controls" .}}</div></section>{{end}}

{{define "binding-mattermost"}}<section class="card binding-panel" data-binding-channel="mattermost" aria-labelledby="binding-mattermost-heading"><header class="card-header"><h2 id="binding-mattermost-heading" class="card-title"><i class="bi bi-chat-square" aria-hidden="true"></i> Connect Mattermost</h2></header><div class="card-body"><p>Send the invitation to the verified bot. The generated <code>/msg</code> action opens its DM and sends the message.</p>{{with .BotUsername}}<p class="text-body-secondary">Bot: <strong>@{{.}}</strong></p>{{end}}{{if .CommandsEnabled}}<p class="form-text">The configured slash receiver also accepts the generated <code>/balda start</code> command in a direct conversation.</p>{{else}}<p class="form-text">Use the DM action; the Balda slash receiver is not enabled.</p>{{end}}{{template "binding-reveal" .}}{{template "binding-controls" .}}</div></section>{{end}}

{{define "binding-reveal"}}{{with .Reveal}}<div class="locator-reveal mb-3" data-binding-reveal hx-history="false"><p><strong>Invitation generated · shown once</strong></p><p>Single use. Expires {{.ExpiresAt.Format "02 Jan 2006 · 15:04 UTC"}}. Send it from the account you want to connect.</p>
<label class="form-label" for="binding-message-{{$.ChannelType}}">Direct message</label><div class="binding-copy-row"><input class="form-control" id="binding-message-{{$.ChannelType}}" value="{{.Payload}}" readonly autocomplete="off" spellcheck="false" data-binding-secret><button class="btn btn-outline-secondary enhanced-only" type="button" data-binding-copy="binding-message-{{$.ChannelType}}">Copy message</button></div>
{{if .Command}}<label class="form-label mt-3" for="binding-command-{{$.ChannelType}}">{{if eq $.ChannelType "slackagent"}}Slack native command{{else if eq $.ChannelType "mattermost"}}Mattermost slash command{{else}}Bot start command{{end}}</label><div class="binding-copy-row"><input class="form-control" id="binding-command-{{$.ChannelType}}" value="{{.Command}}" readonly autocomplete="off" spellcheck="false" data-binding-secret><button class="btn btn-outline-secondary enhanced-only" type="button" data-binding-copy="binding-command-{{$.ChannelType}}">Copy command</button></div>{{end}}
{{if .DMCommand}}<label class="form-label mt-3" for="binding-dm-{{$.ChannelType}}">Send directly to the bot</label><div class="binding-copy-row"><input class="form-control" id="binding-dm-{{$.ChannelType}}" value="{{.DMCommand}}" readonly autocomplete="off" spellcheck="false" data-binding-secret><button class="btn btn-outline-secondary enhanced-only" type="button" data-binding-copy="binding-dm-{{$.ChannelType}}">Copy DM action</button></div>{{end}}
<p class="form-text">You can select and copy these fields manually. Reload shows status only; use Replace invitation if you lose this value.</p><p class="small mb-0" data-binding-copy-status role="status"></p>
{{if .BotURL}}<div class="action-row mt-3"><a class="btn btn-primary" href="{{.BotURL}}" hx-boost="false" target="_blank" rel="noopener noreferrer" data-binding-secret>{{if eq $.ChannelType "telegram"}}Open Telegram bot{{else if eq $.ChannelType "slackagent"}}Open Slack DM{{else if eq $.ChannelType "zulip"}}Open Zulip DM{{else}}Open Mattermost{{end}}</a></div>{{end}}
</div>{{end}}{{end}}

{{define "binding-controls"}}
{{with .Error}}<div class="alert alert-danger" role="alert">{{.}}</div>{{end}}
{{range .Pending}}<div class="channel-stack-item d-block mb-3"><p class="mb-1"><span class="status-chip {{if .Expired}}status-chip--warning{{else}}status-chip--info{{end}}">{{if .Expired}}Expired{{else}}Waiting for confirmation{{end}}</span></p><p class="small text-body-secondary">Expires {{.ExpiresAt.Format "02 Jan 2006 · 15:04 UTC"}}.{{if not .Current}} Issued for a previous bot configuration.{{end}}</p><details><summary>Cancel invitation</summary><form class="mt-2" action="{{path "/"}}access/users/{{$.UserID}}/invitations/{{$.ChannelType}}/cancel" method="post" hx-post="{{path "/"}}access/users/{{$.UserID}}/invitations/{{$.ChannelType}}/cancel" hx-target="#main-content" hx-swap="outerHTML">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="invitation_id" value="{{.ID}}"><input type="hidden" name="invitation_version" value="{{.Version}}"><div class="form-check mb-2"><input class="form-check-input" id="cancel-invitation-{{.ID}}" type="checkbox" name="confirm_cancel" value="yes" required><label class="form-check-label" for="cancel-invitation-{{.ID}}">Stop this invitation from connecting an account.</label></div><button class="btn btn-sm btn-outline-danger" type="submit"{{if $.Preview}} disabled{{end}}>Cancel invitation</button></form></details></div>{{end}}
{{if .Disabled}}<p class="form-text">Enable this user before generating an invitation.</p>{{else if not .Ready}}<div class="empty-state binding-unavailable"><p>Bot connection could not be verified. Retry before generating an invitation.</p><form action="{{path "/"}}access/users/{{.UserID}}/invitations/{{.ChannelType}}/identity" method="post" hx-post="{{path "/"}}access/users/{{.UserID}}/invitations/{{.ChannelType}}/identity" hx-target="#main-content" hx-swap="outerHTML"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="btn btn-outline-secondary" type="submit"{{if .Preview}} disabled{{end}}>Retry connection</button></form></div>{{else}}
{{if .Active}}<details class="mt-3"><summary class="btn btn-outline-secondary">Replace invitation</summary>{{end}}
<form class="mt-3" data-binding-issue="{{.ChannelType}}" action="{{path "/"}}access/users/{{.UserID}}/invitations/{{.ChannelType}}" method="post" hx-post="{{path "/"}}access/users/{{.UserID}}/invitations/{{.ChannelType}}" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="false" hx-history="false"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><input type="hidden" name="expected_version" value="{{.UserVersion}}">
{{if .Active}}<div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="replace-invitation-{{.ChannelType}}" name="replace" value="yes" required><label class="form-check-label" for="replace-invitation-{{.ChannelType}}">Invalidate the pending invitation and show a new one.</label></div>{{else}}<p class="form-text">Generate a single-use invitation for this user. Their role stays the same.</p>{{end}}<button class="btn btn-primary" type="submit"{{if .Preview}} disabled{{end}}>{{if .Active}}Generate replacement{{else}}Generate invitation{{end}}</button></form>{{if .Active}}</details>{{end}}{{end}}
{{end}}
